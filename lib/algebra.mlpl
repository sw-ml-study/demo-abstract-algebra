# lib/algebra.mlpl -- finite algebraic structures as arrays.
#
# A finite binary operation on n elements IS an n x n Cayley table T, where
# T[a, b] is the index of a * b.  Every law in this repository is therefore an
# array predicate over T, checked without an explicit loop.
#
# Element identity is the index 0 .. n-1 throughout; human names live beside
# the table in a string list, never inside it.
#
# loops: 0

# ---------------------------------------------------------------------------
# Construction
# ---------------------------------------------------------------------------

# The [n] header vector 0 .. n-1: the element indices, and the row/column
# headings of every Cayley table.
def u:elements(n) { range(n) }

# Element index count for a table.
def u:order(t) { tally(t) }

# The [n, n] matrix whose every row is the header (H[a, b] = b).  sw-MLPL
# broadcasts SCALARS only, so a rank-1 header cannot be compared against a
# rank-2 table directly; this materializes it.  See docs/upstream-asks.md #2.
def u:second(x, y) { y }
def u:header_matrix(n) { table(:u:second, u:elements(n), u:elements(n)) }

# The [n, n] matrix whose every column is the header (K[a, b] = a).
def u:first(x, y) { x }
def u:index_matrix(n) { table(:u:first, u:elements(n), u:elements(n)) }

# ---------------------------------------------------------------------------
# The two associativity cubes
# ---------------------------------------------------------------------------
#
# These are the whole trick.  For a table T of order n:
#
#   left_cube(T)[a, b, c]  = T[T[a, b], c]   -- (a * b) * c
#   right_cube(T)[a, b, c] = T[a, T[b, c]]   -- a * (b * c)
#
# gather_rows(T, flatten(T)) indexes T by every entry of T at once, producing
# the [n*n, n] matrix whose (a*n + b, c) cell is T[T[a, b], c].  Reshaping to
# [n, n, n] is the left cube.  The right cube is the same gather against the
# transpose, which yields axes in (b, c, a) order and is permuted back.
#
# All n^3 triples, no loop.

def u:left_cube(t) {
  n = u:order(t)
  reshape(gather_rows(t, flatten(t)), [n, n, n])
}

def u:right_cube(t) {
  n = u:order(t)
  reshape(gather_rows(transpose(t), flatten(t)), [n, n, n])
}

# The [n, n, n] 0/1 cube: 1 where the two bracketings agree.
def u:assoc_cube(t) {
  eq(u:left_cube(t), transpose_axes(u:right_cube(t), [2, 0, 1]))
}

# ---------------------------------------------------------------------------
# Law predicates -- each returns scalar 1 or 0
# ---------------------------------------------------------------------------

# Closure: every entry names a real element.  No ge/le builtins exist, so
# "not below zero" is spelled 1 - lt(...).  See docs/upstream-asks.md #1.
# [n, n] mask: 1 where the entry names a real element of the set.
def u:inside_mask(t) {
  n = u:order(t)
  (1 - lt(t, 0)) * lt(t, n) * eq(t, floor(t))
}

def u:is_closed(t) { reduce(:and, flatten(u:inside_mask(t))) }

# Associativity is not merely false on a non-closed table -- it is UNDEFINED.
# (a * b) * c cannot be evaluated when a * b is not an element, and the cube
# gathers by table entries, so an escaping value would index out of range.
# Answer 0 without touching the cube; u:is_closed is the question that matters
# first, and u:structure_name reports "not-a-magma".
def u:is_associative(t) {
  if u:is_closed(t) { reduce(:and, flatten(u:assoc_cube(t))) } else { 0 }
}

def u:is_commutative(t) { equal(t, transpose(t)) }

# ---------------------------------------------------------------------------
# Identity and inverses
# ---------------------------------------------------------------------------

# [n] mask: 1 at each two-sided identity.  Element e is an identity when row e
# reproduces the header AND column e does too.
def u:identity_mask(t) {
  h = u:header_matrix(u:order(t))
  reduce(:and, eq(t, h), 1) * reduce(:and, eq(transpose(t), h), 1)
}

def u:has_identity(t) { reduce(:or, u:identity_mask(t)) }

# The identity element index, or -1 when there is none.  A monoid's identity
# is unique, so argmax over the mask is exact.
def u:identity_of(t) {
  m = u:identity_mask(t)
  argmax(m) * reduce(:or, m) - (1 - reduce(:or, m))
}

# [n, n] mask: 1 where a * b equals the identity, i.e. b is a right inverse of
# a.  Meaningless without an identity, so it is gated to the zero matrix.
def u:inverse_mask(t) {
  e = u:identity_of(t)
  eq(t, e) * u:has_identity(t)
}

# [n] mask: 1 at each element with a two-sided inverse.
def u:invertible_mask(t) {
  right = reduce(:or, u:inverse_mask(t), 1)
  left = reduce(:or, u:inverse_mask(t), 0)
  right * left
}

def u:has_inverses(t) { reduce(:and, u:invertible_mask(t)) }

# ---------------------------------------------------------------------------
# Classification -- the ladder is DERIVED, never declared
# ---------------------------------------------------------------------------

# Rungs, as a record of 0/1 flags.  A structure is whatever its laws say it is.
def u:classify(t) {
  closed = u:is_closed(t)
  assoc = u:is_associative(t)
  ident = u:has_identity(t)
  inv = u:has_inverses(t)
  comm = u:is_commutative(t)
  {
    closed: closed,
    associative: assoc,
    commutative: comm,
    identity: ident,
    inverses: inv,
    magma: closed,
    semigroup: closed * assoc,
    monoid: closed * assoc * ident,
    group: closed * assoc * ident * inv,
    abelian_group: closed * assoc * ident * inv * comm
  }
}

# The highest rung reached, as a name.
def u:structure_name(t) {
  c = u:classify(t)
  unwrap(list_get(
    ["not-a-magma", "magma", "semigroup", "monoid", "group", "abelian group"],
    c.magma + c.semigroup + c.monoid + c.group + c.abelian_group))
}

# ---------------------------------------------------------------------------
# Counterexamples -- a failed law must name a witness, never just say "no"
# ---------------------------------------------------------------------------

# The first (a, b, c) triple where the two bracketings disagree, as the record
# {found, a, b, c, left, right}.  Lexicographic first, so the witness is stable.
def u:assoc_counterexample(t) {
  if u:is_closed(t) { u:assoc_witness(t) } else { u:no_witness() }
}

# No triple to exhibit: on a non-closed table the question does not arise.
def u:no_witness() {
  {found: 0, a: 0, b: 0, c: 0, ab: 0, bc: 0, left: 0, right: 0}
}

def u:assoc_witness(t) {
  n = u:order(t)
  cube = u:assoc_cube(t)
  flat = flatten(cube)
  found = 1 - reduce(:and, flat)
  # grade_up is a STABLE ascending argsort, so entry 0 is the lowest-indexed
  # zero whenever any zero exists.
  i = take(grade_up(flat), 0, 0) * found
  a = floor(i / (n * n))
  b = floor(mod(i, n * n) / n)
  c = mod(i, n)
  {
    found: found,
    a: a,
    b: b,
    c: c,
    ab: take(take(t, 0, a), 0, b),
    bc: take(take(t, 0, b), 0, c),
    left: take(take(take(u:left_cube(t), 0, a), 0, b), 0, c),
    right: take(take(take(transpose_axes(u:right_cube(t), [2, 0, 1]), 0, a), 0, b), 0, c)
  }
}

# The first (a, b) pair where a * b differs from b * a.
def u:comm_counterexample(t) {
  n = u:order(t)
  agree = eq(t, transpose(t))
  flat = flatten(agree)
  found = 1 - reduce(:and, flat)
  i = take(grade_up(flat), 0, 0) * found
  a = floor(i / n)
  b = mod(i, n)
  {
    found: found,
    a: a,
    b: b,
    left: take(take(t, 0, a), 0, b),
    right: take(take(t, 0, b), 0, a)
  }
}

# The first entry that escapes the element set, as {found, a, b, value}.
def u:closure_counterexample(t) {
  n = u:order(t)
  flat = flatten(u:inside_mask(t))
  found = 1 - reduce(:and, flat)
  i = take(grade_up(flat), 0, 0) * found
  a = floor(i / n)
  b = mod(i, n)
  {found: found, a: a, b: b, value: take(take(t, 0, a), 0, b)}
}

# ---------------------------------------------------------------------------
# Structure-preserving maps
# ---------------------------------------------------------------------------
#
# f : M -> N given as an [m] vector of target indices.  f is a homomorphism
# when f(a *M b) = f(a) *N f(b) for every a, b in M.  Both sides are [m, m]
# matrices, so the check is one comparison.

# Rename every ENTRY of a table through the map p: out[a, b] = p[t[a, b]].
def u:apply_names(t, p) {
  reshape(gather_rows(reshape(p, [tally(p), 1]), flatten(t)), shape(t))
}

# Re-index both AXES of a table through the map idx:
#   out[a, b] = t[idx[a], idx[b]]
# With idx of length m this narrows or widens an [n, n] table to [m, m], which
# is what a homomorphism's right-hand side needs.
def u:gather2(t, idx) {
  transpose(gather_rows(transpose(gather_rows(t, idx)), idx))
}

# f : M -> N is a homomorphism when f(a *M b) = f(a) *N f(b) everywhere.
# Left side renames the entries of M's table; right side re-indexes N's table.
def u:hom_lhs(f, s) { u:apply_names(s, f) }
def u:hom_rhs(f, t) { u:gather2(t, f) }
def u:is_homomorphism(f, s, t) { equal(u:hom_lhs(f, s), u:hom_rhs(f, t)) }

# The first (a, b) pair where a candidate map fails to preserve the operation.
def u:hom_counterexample(f, s, t) {
  m = tally(f)
  agree = eq(u:hom_lhs(f, s), u:hom_rhs(f, t))
  flat = flatten(agree)
  found = 1 - reduce(:and, flat)
  i = take(grade_up(flat), 0, 0) * found
  a = floor(i / m)
  b = mod(i, m)
  {
    found: found,
    a: a,
    b: b,
    left: take(take(u:hom_lhs(f, s), 0, a), 0, b),
    right: take(take(u:hom_rhs(f, t), 0, a), 0, b)
  }
}

# Relabel a table under the permutation p (p[i] is the new name of element i).
# For a permutation, grade_up(p) IS the inverse permutation.
# Two tables are isomorphic exactly when some permutation makes them equal.
def u:permute_table(t, p) { u:apply_names(u:gather2(t, grade_up(p)), p) }

def u:is_isomorphic_under(s, t, p) { equal(u:permute_table(s, p), t) }
