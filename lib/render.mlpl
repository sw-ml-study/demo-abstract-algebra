# lib/render.mlpl -- turning Cayley tables into things a learner can look at.
#
# THE STRUCTURE RECORD.  Every renderer here takes one argument:
#
#   s = {title: "Rock-Paper-Scissors", names: ["rock", ...], table: t}
#
# This started as a workaround: sw-MLPL used to refuse a string-list as a `u:`
# argument, so bundling was the only way to hand a renderer its element names.
# That restriction is gone (work-order B5), and the record STAYS -- by choice
# now, not by force.  A finite structure IS a title, a set of names and a
# table, and passing the three separately to fourteen renderers would be worse.
# The web demos, where the wrapper carried nothing but names, pass plain lists.
#
# Text is built with str_join and to_string, which landed upstream as
# work-order B1 and B2. Before they existed this file carried two bridges --
# an O(n^2) byte round-trip for joining and a to_json lean for numbers -- and
# both are now deleted. str_join takes the whole fragment list in one
# linear-time call, so an SVG element reads as the list of pieces it is.
#
# The built-in svg(t, "heatmap") colors a table but draws no headings, no cell
# values, and no highlights, which is most of what teaches (upstream ask #5).
# cayley_svg below emits its own SVG instead.
#
# loops: 0

# ---------------------------------------------------------------------------
# String primitives
# ---------------------------------------------------------------------------

def u:element_name(s, i) { "Answer the human name of element i in this structure."; unwrap(list_get(s.names, i)) }

# A table's cells do not always name elements of the SAME set. A homomorphism
# picture has source elements on the headings and target elements in the
# cells, so a structure may carry an optional cell_names for the latter.
def u:cell_name(s, v) { "Answer the name to print inside a cell: cell_names when the record carries them, otherwise the element names.";
  if has_field(s, "cell_names") { unwrap(list_get(s.cell_names, v)) } else { u:element_name(s, v) }
}

def u:cell_range(s) { "Answer how many distinct values a cell may hold, which is the target size when cells and headings name different sets.";
  if has_field(s, "cell_names") { list_len(s.cell_names) } else { u:order(s.table) }
}
def u:yes_or_no(b) { "Answer the word yes or no for a 1 or 0 verdict, for printing law checklists."; unwrap(list_get(["no", "yes"], b)) }

# ---------------------------------------------------------------------------
# ASCII: the first visual, and the one that always works
# ---------------------------------------------------------------------------

def u:show_table(s) { "Print the structure title, its element names, and its Cayley table as an ASCII grid.";
  print(s.title)
  print("  elements:", s.names)
  print(disp(s.table))
}

# A law checklist, plus the rung of the ladder the structure reaches.
def u:show_laws(s) { "Print which laws hold and the ladder rung reached, all derived from the table.";
  c = u:classify(s.table)
  print("  closed      ", u:yes_or_no(c.closed))
  print("  associative ", u:yes_or_no(c.associative))
  print("  commutative ", u:yes_or_no(c.commutative))
  print("  identity    ", u:yes_or_no(c.identity))
  print("  inverses    ", u:yes_or_no(c.inverses))
  print("  =>", u:structure_name(s.table))
}

# A failed law must name a witness, never just say "no".
def u:show_assoc_counterexample(s) { "Print the triple where bracketing changes the answer, spelled out both ways, and answer the witness record.";
  x = u:assoc_counterexample(s.table)
  print("  associativity counterexample:")
  print("    a =", u:element_name(s, x.a), " b =", u:element_name(s, x.b), " c =", u:element_name(s, x.c))
  print("    (a*b)*c:  a*b =", u:element_name(s, x.ab), " -> ", u:element_name(s, x.left))
  print("    a*(b*c):  b*c =", u:element_name(s, x.bc), " -> ", u:element_name(s, x.right))
  x
}

def u:show_comm_counterexample(s) { "Print the pair where a * b differs from b * a, and answer the witness record.";
  x = u:comm_counterexample(s.table)
  print("  commutativity counterexample:")
  print("    a =", u:element_name(s, x.a), " b =", u:element_name(s, x.b))
  print("    a*b =", u:element_name(s, x.left), "  b*a =", u:element_name(s, x.right))
  x
}

# ===========================================================================
# RENDERING SUPPORT
#
# Nothing below this line is needed to define or check any algebra. It only
# turns an operation into a picture. A reader following the mathematics can
# skip to the lessons; every docstring from here on begins "SVG helper:" to
# say so.
# ===========================================================================

# ---------------------------------------------------------------------------
# SVG fragments
# ---------------------------------------------------------------------------

# WIDTH AND HEIGHT ARE NOT OPTIONAL.
#
# A standalone .svg file with only a viewBox renders fine -- it fills the
# viewport. Inline in a page it does not: with no intrinsic width it defaults
# to 100%, and the playground's result panel is `display: inline-block`, which
# shrink-wraps to its content. Circular, so the picture collapses to zero and
# all the reader sees is the download arrow. Every built-in renderer emits
# both attributes; so must this one.
def u:svg_open(w, h) { "SVG helper: opening svg tag. WIDTH AND HEIGHT ARE REQUIRED: inline, a viewBox alone collapses to nothing.";
  str_join(["<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 ", to_string(w), " ", to_string(h),
    "\" width=\"", to_string(w), "\" height=\"", to_string(h),
    "\" font-family=\"ui-monospace,Menlo,monospace\" font-size=\"12\">"], "")
}

def u:svg_rect(x, y, w, h, fill) { "SVG helper: filled rectangle.";
  str_join(["<rect x=\"", to_string(x), "\" y=\"", to_string(y),
    "\" width=\"", to_string(w), "\" height=\"", to_string(h),
    "\" fill=\"", fill, "\"/>"], "")
}

def u:svg_frame(x, y, w, h, stroke) { "SVG helper: unfilled rectangle, used to ring cells that a law makes special.";
  str_join(["<rect x=\"", to_string(x), "\" y=\"", to_string(y),
    "\" width=\"", to_string(w), "\" height=\"", to_string(h),
    "\" fill=\"none\" stroke-width=\"3\" stroke=\"", stroke, "\"/>"], "")
}

def u:svg_text(x, y, fill, s) { "SVG helper: text element centered on the given point.";
  str_join(["<text x=\"", to_string(x), "\" y=\"", to_string(y), "\" fill=\"", fill,
    "\" text-anchor=\"middle\" dominant-baseline=\"central\">", s, "</text>"], "")
}

def u:svg_text_left(x, y, fill, s) { "SVG helper: text element starting at the given point.";
  str_join(["<text x=\"", to_string(x), "\" y=\"", to_string(y), "\" fill=\"", fill,
    "\" text-anchor=\"start\" dominant-baseline=\"central\">", s, "</text>"], "")
}

# Approximate rendered width of a monospace string, in px.
# BYTE length, not character length -- sw-MLPL cannot count characters
# (docs/mlpl-blockers.md, B3).  Exact for the ASCII labels used here; a
# non-ASCII title would over-estimate, which errs toward not clipping.
def u:text_width_px(s, font_px) { "SVG helper: roughly how wide a string will render, so titles are never clipped. Counts BYTES; sw-MLPL cannot count characters (B3)."; round(size(tokenize_bytes(s)) * font_px * 0.70) }

def u:larger_of(a, b) { "Answer whichever of the two numbers is larger."; if lt(a, b) { b } else { a } }

# ---------------------------------------------------------------------------
# SVG: the labelled, colored, highlighted Cayley table
# ---------------------------------------------------------------------------
#
# One color per element, so structure is visible before a single name is read:
# a constant row is one stripe; an identity row reproduces the header's colors;
# a group's table is a Latin square -- every color exactly once per row and
# column.  That last one is the payoff, and it is visible at a glance.

def u:element_color(element) { "SVG helper: color that stands for element i, so identity is visible before any name is read.";
  unwrap(list_get(
    ["#7aa2f7", "#f7768e", "#9ece6a", "#e0af68", "#bb9af7",
     "#7dcfff", "#ff9e64", "#73daca"], mod(element, 8)))
}

def u:cell_size_px() { "SVG helper: edge length of one table cell."; 64 }
def u:heading_gutter_px() { "SVG helper: space reserved for row and column headings."; 68 }
def u:title_band_px() { "SVG helper: space reserved for the diagram title."; 34 }

def u:cell_svg(structure, row, column) { "SVG helper: one table cell: a colored square labelled with the name of the result, or grey and marked when the result escapes the set.";
  n = u:cell_range(structure)
  v = take(take(structure.table, 0, row), 0, column)
  x = u:heading_gutter_px() + column * u:cell_size_px()
  y = u:title_band_px() + u:heading_gutter_px() + row * u:cell_size_px()
  inside = (1 - lt(v, 0)) * lt(v, n)
  fill = if inside { u:element_color(v) } else { "#3b3b4d" }
  label = if inside { u:cell_name(structure, v) } else { str_concat("!", to_string(v)) }
  str_concat(u:svg_rect(x + 2, y + 2, u:cell_size_px() - 4, u:cell_size_px() - 4, fill), u:svg_text(x + u:cell_size_px() / 2, y + u:cell_size_px() / 2, "#12131c", label))
}

# Recursive fold over the n*n cells: sw-MLPL has no string reduction, so the
# accumulator is threaded by hand.  Recursion, not an explicit loop.
def u:cells_svg(structure, cell_index, svg_so_far) { "SVG helper: every cell of the table, folded together by recursion because sw-MLPL has no string reduction.";
  n = u:order(structure.table)
  if lt(cell_index, n * n) {
    u:cells_svg(structure, cell_index + 1, str_concat(svg_so_far, u:cell_svg(structure, floor(cell_index / n), mod(cell_index, n))))
  } else { svg_so_far }
}

def u:headers_svg(structure, element, svg_so_far) { "SVG helper: row and column headings.";
  if lt(element, u:order(structure.table)) {
    col = u:svg_text(u:heading_gutter_px() + element * u:cell_size_px() + u:cell_size_px() / 2,
      u:title_band_px() + u:heading_gutter_px() - 14, "#c0caf5", u:element_name(structure, element))
    row = u:svg_text(u:heading_gutter_px() / 2,
      u:title_band_px() + u:heading_gutter_px() + element * u:cell_size_px() + u:cell_size_px() / 2,
      "#c0caf5", u:element_name(structure, element))
    u:headers_svg(structure, element + 1, str_join([svg_so_far, col, row], ""))
  } else { svg_so_far }
}

# A white ring around the identity's row and column, when one exists.  This is
# the picture of "e * x = x and x * e = x": both bands reproduce the headings.
def u:identity_svg(s) { "SVG helper: white rings around the identity element row and column, or nothing when there is no identity.";
  n = u:order(s.table)
  e = u:identity_of(s.table)
  if u:has_identity(s.table) {
    str_concat(u:svg_frame(u:heading_gutter_px(), u:title_band_px() + u:heading_gutter_px() + e * u:cell_size_px(),
        n * u:cell_size_px(), u:cell_size_px(), "#ffffff"), u:svg_frame(u:heading_gutter_px() + e * u:cell_size_px(), u:title_band_px() + u:heading_gutter_px(),
        u:cell_size_px(), n * u:cell_size_px(), "#ffffff"))
  } else { "" }
}

# Cell geometry, shared by the static and animated diagrams.
def u:column_left_px(column) { "SVG helper: x pixel where column b starts."; u:heading_gutter_px() + column * u:cell_size_px() }
def u:row_top_px(row) { "SVG helper: y pixel where row a starts."; u:title_band_px() + u:heading_gutter_px() + row * u:cell_size_px() }
# Wide enough for the grid AND the title, so a long title is never clipped.
def u:diagram_width(s) { "SVG helper: diagram width, wide enough for both the grid and the title.";
  u:larger_of(u:heading_gutter_px() + u:order(s.table) * u:cell_size_px() + 16,
    u:text_width_px(s.title, 12) + 32)
}
def u:diagram_height(s) { "SVG helper: diagram height."; u:title_band_px() + u:heading_gutter_px() + u:order(s.table) * u:cell_size_px() + 16 }

# Headings, cells, and the identity cross -- everything inside the <svg> that
# both the static and the animated diagram share.
def u:table_body(s) { "SVG helper: headings, cells and identity rings that every table diagram shares.";
  str_join([u:headers_svg(s, 0, ""), u:cells_svg(s, 0, ""), u:identity_svg(s)], "")
}

def u:cayley_svg(s) { "SVG helper: labelled, color-coded Cayley table as an SVG document.";
  w = u:diagram_width(s)
  h = u:diagram_height(s)
  str_join([str_join([u:svg_open(w, h), u:svg_rect(0, 0, w, h, "#1a1b26"), u:svg_text(w / 2, 18, "#c0caf5", s.title)], ""), u:table_body(s), "</svg>"], "")
}

# Render and write in one call; returns the Result from write_text.
def u:write_cayley_svg(path, s) { "SVG helper: write the Cayley table diagram to a file and answer the Result."; write_text(path, u:cayley_svg(s)) }

# ---------------------------------------------------------------------------
# Animated SVG: watching associativity fail
# ---------------------------------------------------------------------------
#
# Animation is SMIL, which is text, so it costs nothing that static SVG did not
# already cost -- no encoder, no new builtin, no binary format.  It stays
# scalable, diffable, and renders anywhere an <img> does.
#
# The animation IS the lesson.  Two markers start on different cells and walk
# the two bracketings of the same three elements:
#
#   left  marker: (a, b) -> read a*b -> (a*b, c) -> read (a*b)*c
#   right marker: (b, c) -> read b*c -> (a, b*c) -> read a*(b*c)
#
# They land on different colors.  That is what non-associativity looks like,
# and no prose does it as well.

# One marker: a ring that dwells on a cell, slides, and dwells again.  `values`
# and `keyTimes` carry the whole path, so the animation is declarative and the
# document needs no script.
def u:marker_svg(x0, y0, x1, y1, color, delay) { "SVG helper: ring that dwells on one cell, slides to another, and dwells again, tracing one bracketing.";
  str_join([str_join(["<rect x=\"", to_string(x0), "\" y=\"", to_string(y0), "\" "], ""), str_join(["width=\"", to_string(u:cell_size_px()), "\" height=\"", to_string(u:cell_size_px()), "\" "], ""), str_join(["fill=\"none\" stroke=\"", color, "\" stroke-width=\"4\" rx=\"6\">"], ""), str_concat(u:animate_attribute("x", u:hold_then_slide(x0, x1), delay), u:animate_attribute("y", u:hold_then_slide(y0, y1), delay)), "</rect>"], "")
}

# Two stops, each held long enough to read: start, hold, slide, hold.
def u:hold_then_slide(first_value, second_value) { "SVG helper: four SMIL stops that hold a value, move to a second, and hold again.";
  str_join([to_string(first_value), ";", to_string(first_value), ";", str_join([to_string(second_value), ";", to_string(second_value)], "")], "")
}

# values and keyTimes must have equal length -- a mismatch makes the browser
# drop the animation silently, which is why tests/test_render.mlpl counts both.
def u:animate_attribute(attr, values, delay) { "SVG helper: SMIL animate element. values and keyTimes must have equal length or browsers drop it silently.";
  str_join([str_join(["<animate attributeName=\"", attr, "\" "], ""), str_join(["values=\"", values, "\" "], ""), "keyTimes=\"0;0.35;0.5;1\" dur=\"5s\" ", str_join(["begin=\"", to_string(delay), "s\" "], ""), "repeatCount=\"indefinite\" calcMode=\"linear\"/>"], "")
}

# A legend row: marker swatch, the expression, then the element it reaches in
# that element's own color.  Laid out from the right edge so nothing runs off.
def u:legend_svg(s, y, color, label, result) { "SVG helper: one legend row: a marker swatch, the expression it traces, and the element it reaches.";
  w = u:diagram_width(s)
  str_join([str_concat(u:svg_rect(16, y - 8, 14, 14, color), u:svg_text_left(38, y, "#c0caf5", label)), u:svg_text_left(112, y, "#565f89", "="), str_concat(u:svg_rect(w - 132, y - 8, 14, 14, u:element_color(result)), u:svg_text_left(w - 110, y, "#c0caf5", u:element_name(s, result)))], "")
}

# The whole animated diagram.  Returns "" when the operation IS associative --
# there is no counterexample to walk, and drawing one would be a lie.
def u:assoc_walk_svg(s) { "SVG helper: animation of two markers walking the two bracketings to different results, or nothing when the operation IS associative.";
  x = u:assoc_counterexample(s.table)
  if x.found { u:assoc_walk_found(s, x) } else { "" }
}

def u:assoc_walk_found(s, x) { "SVG helper: walk animation for a table already known to have a disagreeing triple.";
  w = u:diagram_width(s)
  h = u:diagram_height(s) + 76
  caption = str_join(["(", u:element_name(s, x.a), "*", u:element_name(s, x.b), str_join([")*", u:element_name(s, x.c), "  vs  ", u:element_name(s, x.a), "*("], "")], "")
  str_join([str_join([u:svg_open(w, h), u:svg_rect(0, 0, w, h, "#1a1b26"), u:svg_text(w / 2, 18, "#c0caf5", s.title)], ""), str_join([u:table_body(s), # Left bracketing: (a*b) then (a*b)*c.
      u:marker_svg(u:column_left_px(x.b), u:row_top_px(x.a), u:column_left_px(x.c), u:row_top_px(x.ab),
        "#ffffff", 0), # Right bracketing: (b*c) then a*(b*c).  Offset so both are readable.
      u:marker_svg(u:column_left_px(x.c), u:row_top_px(x.b), u:column_left_px(x.bc), u:row_top_px(x.a),
        "#f7768e", 0.4)], ""), str_join([u:legend_svg(s, u:diagram_height(s) + 12, "#ffffff", "(a*b)*c", x.left), u:legend_svg(s, u:diagram_height(s) + 40, "#f7768e", "a*(b*c)", x.right), "</svg>"], "")], "")
}

def u:write_assoc_walk_svg(path, s) { "SVG helper: write the associativity walk animation to a file and answer the Result."; write_text(path, u:assoc_walk_svg(s)) }

# ---------------------------------------------------------------------------
# Animated frames: which pairings produce which element
# ---------------------------------------------------------------------------
#
# The built-in svg(frames, "life") animates a [T, H, W] array, and for a Cayley
# table it is close to unreadable: no row or column labels, every lit cell the
# same green -- so a frame cannot say WHICH element it is about -- a fixed
# 0.35s per frame, and no caption. See docs/upstream-asks.md #12 and #13.
#
# This renderer keeps the whole labelled table on screen and RINGS the cells
# belonging to frame k, captioned with the element's name, at a pace you can
# read. Nothing blinks out of existence, so you never lose your place.

def u:seconds_per_frame() { "SVG helper: how long each animation frame is held, slow enough to read a labelled table."; 1.6 }

# One ring per cell whose product is element k.
def u:frame_rings(structure, element, cell_index, svg_so_far) { "SVG helper: rings around every cell whose result is element k.";
  n = u:order(structure.table)
  if lt(cell_index, n * n) {
    a = floor(cell_index / n)
    b = mod(cell_index, n)
    piece = if eq(take(take(structure.table, 0, a), 0, b), element) {
      u:svg_frame(u:column_left_px(b) + 3, u:row_top_px(a) + 3, u:cell_size_px() - 6,
        u:cell_size_px() - 6, "#ffffff")
    } else { "" }
    u:frame_rings(structure, element, cell_index + 1, str_concat(svg_so_far, piece))
  } else { svg_so_far }
}

# Discrete opacity: frame k is the only visible overlay during its 1/n slot.
# values and keyTimes must be the same length or browsers drop the animation
# silently, so both are built from the same three stops.
def u:frame_anim(element, element_count) { "SVG helper: discrete SMIL schedule that shows frame k only during its own slot of the loop.";
  t0 = round(1000 * element / element_count) / 1000
  t1 = round(1000 * (element + 1) / element_count) / 1000
  str_join([str_join(["<animate attributeName=\"opacity\" dur=\"", to_string(element_count * u:seconds_per_frame()), "s\" "], ""), "repeatCount=\"indefinite\" calcMode=\"discrete\" ", str_join(["keyTimes=\"0;", to_string(t0), ";", to_string(t1), ";1\" "], ""), "values=\"0;1;0;0\"", "/>"], "")
}

# The overlay for one frame: the rings, plus a caption naming the element.
def u:frame_group(structure, element) { "SVG helper: one frame overlay: the rings for element k, captioned with its name.";
  n = u:order(structure.table)
  str_join([str_join(["<g opacity=\"0\">", u:frame_rings(structure, element, 0, ""), u:svg_text(u:diagram_width(structure) / 2, u:diagram_height(structure) + 16, u:element_color(element),
        str_join(["a * b  =  ", u:element_name(structure, element), ""], ""))], ""), u:frame_anim(element, n), "</g>"], "")
}

def u:frame_groups(structure, element, svg_so_far) { "SVG helper: every frame overlay, one per element.";
  if lt(element, u:order(structure.table)) {
    u:frame_groups(structure, element + 1, str_concat(svg_so_far, u:frame_group(structure, element)))
  } else { svg_so_far }
}

# The labelled table, animated: every element highlighted in turn.
def u:frames_svg(s) { "SVG helper: labelled table animated, ringing each element in turn. The built-in life renderer cannot label or pace itself; see work-order C1.";
  w = u:diagram_width(s)
  h = u:diagram_height(s) + 34
  str_join([str_join([u:svg_open(w, h), u:svg_rect(0, 0, w, h, "#1a1b26"), u:svg_text(w / 2, 18, "#c0caf5", s.title)], ""), str_concat(u:table_body(s), u:frame_groups(s, 0, "")), "</svg>"], "")
}

def u:write_frames_svg(path, s) { "SVG helper: write the animated frames diagram to a file and answer the Result."; write_text(path, u:frames_svg(s)) }

# ---------------------------------------------------------------------------
# The labelled table with a set of cells ringed
# ---------------------------------------------------------------------------
#
# Several laws are "these particular cells are special": the pairs that
# multiply to the identity, the row and column an identity owns, the cells a
# homomorphism gets wrong. One renderer covers them all -- draw the table, ring
# the cells an [n, n] 0/1 mask selects.

def u:ring_cells(structure, mask, cell_index, svg_so_far) { "SVG helper: rings around every cell the given mask selects.";
  n = u:order(structure.table)
  if lt(cell_index, n * n) {
    a = floor(cell_index / n)
    b = mod(cell_index, n)
    piece = if take(take(mask, 0, a), 0, b) {
      u:svg_frame(u:column_left_px(b) + 3, u:row_top_px(a) + 3, u:cell_size_px() - 6,
        u:cell_size_px() - 6, "#ffffff")
    } else { "" }
    u:ring_cells(structure, mask, cell_index + 1, str_concat(svg_so_far, piece))
  } else { svg_so_far }
}

# The table, with the masked cells ringed and a caption saying what they are.
def u:marked_svg(s, mask, caption) { "SVG helper: table with the masked cells ringed and a caption saying what they are.";
  w = u:diagram_width(s)
  h = u:diagram_height(s) + 30
  str_join([str_join([u:svg_open(w, h), u:svg_rect(0, 0, w, h, "#1a1b26"), u:svg_text(w / 2, 18, "#c0caf5", s.title)], ""), str_join([u:table_body(s), u:ring_cells(s, mask, 0, ""), u:svg_text(w / 2, u:diagram_height(s) + 14, "#9ece6a", caption)], ""), "</svg>"], "")
}

def u:write_marked_svg(path, s, mask, caption) { "SVG helper: write a table with ringed cells to a file and answer the Result.";
  write_text(path, u:marked_svg(s, mask, caption))
}

# ---------------------------------------------------------------------------
# The associativity cube, as a row of slices
# ---------------------------------------------------------------------------
#
# Associativity is a question about n^3 triples, which is one dimension more
# than a page has. Slicing on the first element turns it into n square panels:
# panel a shows, for every (b, c), whether (a * b) * c agrees with a * (b * c).
#
# Green agrees, red does not. A fully associative operation is n green squares
# and nothing else -- which is a very fast thing to check by eye.

def u:panel_cell_px() { "SVG helper: edge length of one cell inside an associativity panel."; 26 }
def u:panel_gap_px() { "SVG helper: space between adjacent panels."; 22 }
def u:panel_side_px(s) { "SVG helper: edge length of one whole panel."; u:order(s.table) * u:panel_cell_px() }

# One cell of one panel.
def u:cube_cell(cube, structure, first, second, third) { "SVG helper: one square of one panel: green when the two bracketings agreed on that triple, red when they did not.";
  agree = take(take(take(cube, 0, first), 0, second), 0, third)
  x = 16 + first * (u:panel_side_px(structure) + u:panel_gap_px()) + third * u:panel_cell_px()
  y = 62 + second * u:panel_cell_px()
  fill = if agree { "#9ece6a" } else { "#f7768e" }
  u:svg_rect(x + 1, y + 1, u:panel_cell_px() - 2, u:panel_cell_px() - 2, fill)
}

def u:cube_cells(cube, structure, triple_index, svg_so_far) { "SVG helper: every square of every panel, one per triple.";
  n = u:order(structure.table)
  if lt(triple_index, n * n * n) {
    a = floor(triple_index / (n * n))
    b = floor(mod(triple_index, n * n) / n)
    c = mod(triple_index, n)
    u:cube_cells(cube, structure, triple_index + 1, str_concat(svg_so_far, u:cube_cell(cube, structure, a, b, c)))
  } else { svg_so_far }
}

# A caption under each panel naming the element it holds fixed.
def u:cube_labels(structure, panel, svg_so_far) { "SVG helper: caption under each panel naming the element it holds fixed.";
  if lt(panel, u:order(structure.table)) {
    x = 16 + panel * (u:panel_side_px(structure) + u:panel_gap_px()) + u:panel_side_px(structure) / 2
    lab = u:svg_text(x, 50, "#c0caf5", str_join(["a = ", u:element_name(structure, panel), ""], ""))
    u:cube_labels(structure, panel + 1, str_concat(svg_so_far, lab))
  } else { svg_so_far }
}

def u:cube_svg(k) { "SVG helper: n^3 associativity check as n square panels, which is how a cube fits on a page.";
  n = u:order(k.table)
  cube = u:assoc_cube(k.table)
  w = 32 + n * u:panel_side_px(k) + (n - 1) * u:panel_gap_px()
  h = 62 + u:panel_side_px(k) + 30
  str_join([str_join([u:svg_open(w, h), u:svg_rect(0, 0, w, h, "#1a1b26"), u:svg_text(w / 2, 18, "#c0caf5", k.title)], ""), str_join([u:svg_text(w / 2, 32, "#565f89",
        "green: (a*b)*c = a*(b*c)   red: they differ"), u:cube_labels(k, 0, ""), u:cube_cells(cube, k, 0, "")], ""), "</svg>"], "")
}

def u:write_cube_svg(path, k) { "SVG helper: write the associativity panels to a file and answer the Result."; write_text(path, u:cube_svg(k)) }

# ---------------------------------------------------------------------------
# The dominance digraph: the same operation, drawn as a graph
# ---------------------------------------------------------------------------
#
# A "winner" operation carries a relation inside it: a beats b exactly when
# a * b = a and a is not b.  Drawing that relation gives a third view of one
# object -- function, table, graph -- and for Rock-Paper-Scissors-Lizard-Spock
# the graph is the view that makes the rules memorable.
#
# Nothing new is computed here.  The graph reads the SAME table the laws are
# checked against, which is the point: three views, one source of truth.

def u:node_ring_radius(s) { "SVG helper: radius of the circle the nodes sit on."; 36 + 28 * u:order(s.table) }
def u:node_ring_center_x(s) { "SVG helper: x center of the node circle."; u:node_ring_radius(s) + 60 }
def u:node_ring_center_y(s) { "SVG helper: y center of the node circle."; u:node_ring_radius(s) + 74 }
def u:node_radius() { "SVG helper: radius of one node."; 32 }

# A node sits at angle -pi/2 + 2*pi*element/n, so element 0 is at the top.
def u:node_x(structure, element) { "SVG helper: x position of a node on the ring, with element 0 at the top.";
  u:node_ring_center_x(structure) + u:node_ring_radius(structure) * cos(0 - pi() / 2 + 2 * pi() * element / u:order(structure.table))
}
def u:node_y(structure, element) { "SVG helper: y position of a node on the ring.";
  u:node_ring_center_y(structure) + u:node_ring_radius(structure) * sin(0 - pi() / 2 + 2 * pi() * element / u:order(structure.table))
}

# An arrow from a to b, stopped short of both node circles so the head is
# visible rather than buried under the target.
def u:edge_svg(structure, from_element, to_element) { "SVG helper: one arrow from a to b, stopped short of both nodes so the head stays visible.";
  x0 = u:node_x(structure, from_element)
  y0 = u:node_y(structure, from_element)
  dx = u:node_x(structure, to_element) - x0
  dy = u:node_y(structure, to_element) - y0
  len = sqrt(dx * dx + dy * dy)
  ux = dx / len
  uy = dy / len
  gap = u:node_radius() + 8
  str_join([str_join(["<line x1=\"", to_string(round(x0 + ux * gap)), "\" y1=\"", to_string(round(y0 + uy * gap)), "\" "], ""), str_join(["x2=\"", to_string(round(x0 + dx - ux * gap)), "\" y2=\"", to_string(round(y0 + dy - uy * gap)), "\" "], ""), "stroke=\"#565f89\" stroke-width=\"2\" ", "marker-end=\"url(#arrow)\"", "/>"], "")
}

def u:edges_svg(structure, pair_index, svg_so_far) { "SVG helper: arrow for every ordered pair where the row beats the column.";
  n = u:order(structure.table)
  if lt(pair_index, n * n) {
    a = floor(pair_index / n)
    b = mod(pair_index, n)
    piece = if u:row_beats_column(structure, a, b) { u:edge_svg(structure, a, b) } else { "" }
    u:edges_svg(structure, pair_index + 1, str_concat(svg_so_far, piece))
  } else { svg_so_far }
}

def u:nodes_svg(structure, element, svg_so_far) { "SVG helper: labelled colored circle for every element.";
  if lt(element, u:order(structure.table)) {
    node = str_concat(str_join([str_join(["<circle cx=\"", to_string(round(u:node_x(structure, element))), "\" cy=\"", to_string(round(u:node_y(structure, element))), "\" "], ""), str_join(["r=\"", to_string(u:node_radius()), "\" fill=\""], ""), str_join([u:element_color(element), "\" stroke=\"#1a1b26\" stroke-width=\"3\"", "/>"], "")], ""), u:svg_text(round(u:node_x(structure, element)), round(u:node_y(structure, element)), "#12131c",
        u:element_name(structure, element)))
    u:nodes_svg(structure, element + 1, str_concat(svg_so_far, node))
  } else { svg_so_far }
}

def u:arrow_defs() { "SVG helper: arrowhead marker definition, referenced by every edge.";
  str_join(["<defs><marker id=\"arrow\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" ", "markerWidth=\"6\" markerHeight=\"6\" orient=\"auto-start-reverse\">", "<path d=\"M 0 0 L 10 5 L 0 10 z\" fill=\"#565f89\"/></marker></defs>"], "")
}

def u:dominance_svg(s) { "SVG helper: operation drawn as a directed graph. sw-MLPL has no graph renderer; see work-order C3.";
  w = u:larger_of(2 * u:node_ring_center_x(s), u:text_width_px(s.title, 12) + 32)
  h = u:node_ring_center_y(s) + u:node_ring_radius(s) + 60
  str_join([str_join([u:svg_open(w, h), u:svg_rect(0, 0, w, h, "#1a1b26"), u:svg_text(w / 2, 18, "#c0caf5", s.title)], ""), str_join([u:arrow_defs(), u:edges_svg(s, 0, ""), u:nodes_svg(s, 0, "")], ""), "</svg>"], "")
}

def u:write_dominance_svg(path, s) { "SVG helper: write the dominance graph to a file and answer the Result."; write_text(path, u:dominance_svg(s)) }

# ---------------------------------------------------------------------------
# Prolog and epilog: a diagram nobody can read has not taught anything
# ---------------------------------------------------------------------------
#
# sw-MLPL's own demo catalog gives every demo an `intro` (what this will show)
# and a `takeaway` (what it showed). Lessons here follow the same shape: say
# what is coming, run it, then describe the picture -- what the axes are, what
# the colors mean, and what to notice. A learner who sees a colored grid with
# no legend has been shown nothing.

def u:banner_rule() { "SVG helper: asterisk rule that frames a printed narration block."; "**********************************************************************" }

def u:prolog(s) { "Print what the lesson is about to show, before any of it happens.";
  print(u:banner_rule())
  print("*", s.title)
  print("*")
  print("*", s.intro)
  print(u:banner_rule())
  print("")
}

def u:epilog_open() { "Print the header that opens the reading key for the artifacts just written.";
  print("")
  print(u:banner_rule())
  print("* HOW TO READ WHAT WAS JUST WRITTEN")
  print(u:banner_rule())
}

# One artifact, with the reading instructions that make it legible.
def u:explain(path, what) { "Print one artifact path and the first line of how to read it.";
  print("")
  print("  ", path)
  print("     ", what)
}

def u:note(what) { "Print one more line of reading guidance under the current artifact."; print("     ", what) }

# What a demo does NOT prove is as much a part of the lesson as what it does.
# The Latin-square error survived because no lesson was required to say where
# its evidence stopped. scripts/check-narration now requires this call.
def u:limits(s) { "Print what the lesson did NOT establish, so a reader knows where the evidence stops.";
  print("")
  print("* WHAT THIS DOES NOT PROVE:", s)
}

def u:takeaway(s) { "Print the single sentence a reader should leave with.";
  print("")
  print("* THE POINT:", s)
  print(u:banner_rule())
  print("")
}

# ---------------------------------------------------------------------------
# JSON: the transport to viewer/ pages
# ---------------------------------------------------------------------------

# Everything a viewer page needs about one structure, as a JSON string.  The
# MLPL side stays authoritative: the page renders these verdicts, and
# tests/test_viewer_conformance.mlpl pins the fixture it is checked against.
def u:structure_record(s) { "Answer everything a viewer page needs about one structure, as a record.";
  {
    title: s.title,
    elements: s.names,
    table: s.table,
    laws: u:classify(s.table),
    structure: u:structure_name(s.table),
    identity: u:identity_of(s.table),
    identity_mask: u:identity_mask(s.table),
    invertible_mask: u:invertible_mask(s.table),
    assoc_counterexample: u:assoc_counterexample(s.table),
    comm_counterexample: u:comm_counterexample(s.table)
  }
}

def u:structure_json(s) { "Answer the structure record as JSON, the transport to viewer pages."; unwrap(to_json(u:structure_record(s), {tagged: 1})) }

def u:write_structure_json(path, s) { "Write the structure JSON to a file and answer the Result."; write_text(path, u:structure_json(s)) }
