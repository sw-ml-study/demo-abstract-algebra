#!/bin/sh
# Every demo must say what it will show, annotate what it runs, and explain
# what the picture means.
#
# sw-MLPL's own demo catalog gives each demo an `intro` and a `takeaway`
# (components/web-demos/.../demos.toml). Lessons and web demos here follow the
# same shape. A diagram nobody can read has not taught anything, and "what am I
# looking at" is a bug, not a documentation preference.
#
#   demos/**/*.mlpl  (CLI)  must call u:prolog, u:epilog_open and u:takeaway
#   demos/web/*.mlpl        must open with "WHAT THIS SHOWS and carry a
#                           "HOW TO READ line after its last visual
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
failures=0

require() {
  file=$1; needle=$2; what=$3
  if ! grep -qF "$needle" "$repo_root/$file"; then
    echo "$file: missing $what" >&2
    failures=$((failures + 1))
  fi
}

for f in $(find "$repo_root/demos" -name '*.mlpl' | sort); do
  rel=${f#$repo_root/}
  case "$rel" in
    demos/web/*)
      gen="web/$(basename "$f")"
      require "$rel" 'WHAT THIS SHOWS' 'a prolog block (# * WHAT THIS SHOWS)'
      require "$rel" 'WHAT TO NOTICE' 'a closing block (# * WHAT TO NOTICE)'
      require "$rel" 'THE POINT' 'a closing point (# * THE POINT)'
      if [ -f "$repo_root/$gen" ]; then
        # The generated file must OPEN on the prolog bar: build-web-demos drops
        # the source header, because leading comments ride with the statement
        # after them and a preamble would be glued onto the narration.
        first=$(grep -v '^[[:space:]]*$' "$repo_root/$gen" | head -n 1)
        case "$first" in
          '# ***'*) ;;
          *) echo "$gen: does not open on a narration bar" >&2
             echo "  got: $(printf '%.60s' "$first")" >&2
             failures=$((failures + 1)) ;;
        esac
        # ...and CLOSE on one, so the last entry is prose with no output --
        # a trailing comment-only group is its own entry (statement_groups.rs
        # emits it deliberately "for narration").
        last=$(grep -v '^[[:space:]]*$' "$repo_root/$gen" | tail -n 1)
        case "$last" in
          '# ***'*) ;;
          *) echo "$gen: does not close on a narration bar" >&2
             echo "  got: $(printf '%.60s' "$last")" >&2
             failures=$((failures + 1)) ;;
        esac
      fi
      ;;
    *)
      require "$rel" 'u:prolog(' 'a u:prolog(...) call'
      require "$rel" 'u:epilog_open()' 'a u:epilog_open() call'
      require "$rel" 'u:takeaway(' 'a u:takeaway(...) call'
      # What a lesson does NOT prove is part of the lesson. The Latin-square
      # error in lesson 08 survived because nothing required it to say where
      # its evidence stopped.
      require "$rel" 'u:limits(' 'a u:limits(...) call saying what is NOT proved'
      require "$rel" 'u:explain(' 'at least one u:explain(path, ...) call'
      ;;
  esac
done

[ "$failures" -eq 0 ] || exit 1
echo "narration: ok"
