#!/bin/sh
# Keep the paste-ready web demos SHORT.
#
# The playground's Run button evaluates a file as balanced statement GROUPS
# (mlpl-web-render-core/src/statement_groups.rs) and puts one entry in the REPL
# transcript per group. A demo that splices a whole library produced 89 groups:
# 88 lines printing "0", with the diagram at the very bottom. It read as
# "no graphics".
#
# The awk below is a port of group_statements: brackets counted outside string
# literals and outside `#` comments, comment-only lines riding with the
# statement that follows. Exceeding the budget fails the gate.
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
budget=${WEB_GROUP_BUDGET:-26}
failures=0

for f in "$repo_root"/web/*.mlpl; do
  [ -f "$f" ] || continue
  groups=$(awk '
    function delta(line,   i, c, d, instr, esc) {
      d = 0; instr = 0; esc = 0
      for (i = 1; i <= length(line); i++) {
        c = substr(line, i, 1)
        if (instr) {
          if (esc) { esc = 0 }
          else if (c == "\\") { esc = 1 }
          else if (c == "\"") { instr = 0 }
          continue
        }
        if (c == "\"") { instr = 1 }
        else if (c == "#") { break }
        else if (c == "(" || c == "[" || c == "{") { d++ }
        else if (c == ")" || c == "]" || c == "}") { d-- }
      }
      return d
    }
    {
      line = $0
      gsub(/^[ \t]+|[ \t]+$/, "", line)
      if (line == "") next
      buf = buf line
      if (substr(line, 1, 1) == "#") next
      depth += delta(line)
      if (depth <= 0) { n++; buf = ""; depth = 0 }
    }
    END { if (buf != "") n++; print n + 0 }
  ' "$f")

  name=${f#$repo_root/}
  if [ "$groups" -gt "$budget" ]; then
    echo "$name: $groups statement groups (budget $budget)" >&2
    echo "  each group is one REPL entry; a long demo buries its own diagram" >&2
    failures=$((failures + 1))
  else
    echo "$name: $groups groups"
  fi
done

[ "$failures" -eq 0 ] || exit 1
