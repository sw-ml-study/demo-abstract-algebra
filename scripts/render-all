#!/bin/sh
# Rebuild every visual artifact under out/ and report what was written.
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

rm -rf "$repo_root/out"
"$repo_root/scripts/run-all" >/dev/null

echo "Artifacts written under out/:"
find "$repo_root/out" -type f | sed "s|$repo_root/||" | sort
