#!/bin/sh
# Every lesson and test script must open with a comment header that names its
# concept, its visual output, and its explicit-loop count.
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
failures=0

for f in $(find "$repo_root/demos" "$repo_root/probes" "$repo_root/tests" "$repo_root/lib" -name '*.mlpl' 2>/dev/null | sort); do
  head -n 32 "$f" | grep -q '^# ' || {
    echo "missing comment header: ${f#$repo_root/}" >&2
    failures=$((failures + 1))
    continue
  }
  case "$f" in
    "$repo_root"/demos/*|"$repo_root"/probes/*)
      head -n 32 "$f" | grep -q '^# loops:' || {
        echo "missing '# loops:' line: ${f#$repo_root/}" >&2
        failures=$((failures + 1))
      }
      head -n 32 "$f" | grep -q '^# visual:' || {
        echo "missing '# visual:' line: ${f#$repo_root/}" >&2
        failures=$((failures + 1))
      }
      ;;
  esac
done

# Every user function must open with a docstring.
#
# sw-MLPL's convention is a nonempty string expression as the first statement
# of the body -- the built-in demo catalog uses it, and mlplunit reads it.
# These files are read by learners, so a function that needs its body read to
# be understood has failed.
#
#   def u:beats(x, y) { "Answer 1 when x beats y."; eq(mod(x - y + 3, 3), 1) }
defs=0
documented=0
for f in $(find "$repo_root/demos" "$repo_root/probes" "$repo_root/tests" "$repo_root/lib" -name '*.mlpl' 2>/dev/null | sort); do
  n=$(grep -cE '^[[:space:]]*def u:' "$f" || true)
  d=$(grep -cE '^[[:space:]]*def u:[A-Za-z0-9_]+\([^)]*\)[[:space:]]*\{[[:space:]]*"[^"]+";' "$f" || true)
  defs=$((defs + n))
  documented=$((documented + d))
  if [ "$n" -ne "$d" ]; then
    echo "${f#$repo_root/}: $d of $n functions documented" >&2
    grep -nE '^[[:space:]]*def u:' "$f" \
      | grep -vE 'def u:[A-Za-z0-9_]+\([^)]*\)[[:space:]]*\{[[:space:]]*"[^"]+";' \
      | head -4 | sed 's/^/    /' >&2
    failures=$((failures + 1))
  fi
done

# Rendering code says so in its docstring. A reader following the mathematics
# needs permission to skip the SVG plumbing, and a one-word prefix gives it.
# Everything after the RENDERING SUPPORT banner in lib/render.mlpl must carry
# it (docs/research2.txt item 7).
render_start=$(grep -n '^# RENDERING SUPPORT' "$repo_root/lib/render.mlpl" | cut -d: -f1)
if [ -n "$render_start" ]; then
  unmarked=$(tail -n "+$render_start" "$repo_root/lib/render.mlpl" \
    | grep -E '^def u:' | grep -v '"SVG helper' | grep -vE 'u:prolog|u:epilog_open|u:explain|u:note|u:takeaway|u:limits|u:structure_record|u:structure_json|u:write_structure_json|u:element_name|u:cell_name|u:cell_range|u:yes_or_no|u:show_|u:larger_of' || true)
  if [ -n "$unmarked" ]; then
    echo "lib/render.mlpl: rendering functions missing the \"SVG helper:\" prefix" >&2
    printf '%s\n' "$unmarked" | head -4 | sed 's/^/    /' >&2
    failures=$((failures + 1))
  fi
fi

[ "$failures" -eq 0 ] || {
  echo "" >&2
  echo "A docstring says what the function ANSWERS, not what its name already says." >&2
  exit 1
}
echo "docstrings: ok ($documented of $defs functions documented)"
