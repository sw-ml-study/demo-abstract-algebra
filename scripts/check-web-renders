#!/bin/sh
# Prove each web demo actually DRAWS something, and say how many pictures.
#
# The playground evaluates a file as balanced statement groups and renders any
# entry whose output starts with "<svg" as an inline widget. So the contract is
# not "the file's final value is an SVG" -- a demo ends with its "HOW TO READ"
# epilog, and its pictures are in the middle. The contract is "at least one
# ENTRY renders".
#
# This reproduces that by evaluating growing prefixes of the demo: prefix k is
# the first k statement groups, so its final value is exactly what entry k
# would show. Counting the prefixes whose value is an SVG counts the widgets a
# reader will see.
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
mlpl=$("$repo_root/scripts/select-mlpl")
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
failures=0

for f in "$repo_root"/web/*.mlpl; do
  [ -f "$f" ] || continue
  name=${f#$repo_root/}

  # Split into statement groups, one file per group (same rule as check-web-size).
  rm -rf "$work/g"; mkdir -p "$work/g"
  awk -v outdir="$work/g" '
    function delta(line,   i, c, d, instr, esc) {
      d = 0; instr = 0; esc = 0
      for (i = 1; i <= length(line); i++) {
        c = substr(line, i, 1)
        if (instr) {
          if (esc) { esc = 0 } else if (c == "\\") { esc = 1 } else if (c == "\"") { instr = 0 }
          continue
        }
        if (c == "\"") { instr = 1 } else if (c == "#") { break }
        else if (c == "(" || c == "[" || c == "{") { d++ }
        else if (c == ")" || c == "]" || c == "}") { d-- }
      }
      return d
    }
    { line = $0; gsub(/^[ \t]+|[ \t]+$/, "", line)
      if (line == "") next
      buf = buf line "\n"
      if (substr(line, 1, 1) == "#") next
      depth += delta(line)
      if (depth <= 0) { n++; printf "%s", buf > sprintf("%s/%04d", outdir, n); close(sprintf("%s/%04d", outdir, n)); buf = ""; depth = 0 }
    }
    END { if (buf != "") { n++; printf "%s", buf > sprintf("%s/%04d", outdir, n) } }
  ' "$f"

  # Evaluate growing prefixes; prefix k's value is what entry k displays.
  # All prefixes share one output directory, and the CLI names an SVG by its
  # CONTENT HASH -- so identical pictures collapse to one file. That matters:
  # a trailing narration block adds no value of its own, so its prefix still
  # reports the previous picture, and counting runs would double-count it.
  rm -rf "$work/svg"; mkdir -p "$work/svg"
  : > "$work/prefix.mlpl"
  for g in "$work"/g/*; do
    cat "$g" >> "$work/prefix.mlpl"
    "$mlpl" --source-dir "$work" --svg-out "$work/svg" "$work/prefix.mlpl" >/dev/null 2>&1 || true
  done
  pictures=$(ls -1 "$work/svg" 2>/dev/null | wc -l | tr -d ' ')

  # Every emitted SVG must carry width AND height, not just a viewBox.
  #
  # A standalone .svg file with only a viewBox fills the viewport and looks
  # fine. Inline in the playground it does not: with no intrinsic width it
  # defaults to 100%, and the result panel is `display: inline-block`, which
  # shrink-wraps to its content. The picture collapses to zero and the reader
  # sees nothing but the download arrow. Every built-in renderer emits both.
  # Check the ROOT <svg ...> tag only: the background <rect> that follows it
  # carries width="100%", so grepping the whole head would always match.
  bare=0
  for got in "$work"/svg/*.svg; do
    [ -f "$got" ] || continue
    root=$(tr -d '\n' < "$got" | sed 's/>.*//')
    printf '%s' "$root" | grep -q ' width=' || bare=$((bare + 1))
    printf '%s' "$root" | grep -q ' height=' || bare=$((bare + 1))
  done
  if [ "$bare" -gt 0 ]; then
    echo "$name: emits an SVG without width/height -- it will render as a" >&2
    echo "  download arrow and nothing else in the playground" >&2
    failures=$((failures + 1))
  fi

  # An SVG may reference a fragment -- url(#arrow) for a marker, a gradient, a
  # clip path -- and a reference with no matching id is silently ignored by
  # every browser: the arrowheads just do not appear. This shipped once, when a
  # parameter rename rewrote url(#a) into url(#from_element) inside a string
  # literal, and nothing caught it because the document still parsed and still
  # drew. Every fragment reference must resolve inside its own document.
  dangling=0
  for got in "$work"/svg/*.svg; do
    [ -f "$got" ] || continue
    for ref in $(grep -o 'url(#[A-Za-z0-9_-]*)' "$got" | sed 's/url(#//; s/)//' | sort -u); do
      grep -q "id=\"$ref\"" "$got" || {
        echo "$name: url(#$ref) refers to no id in the same document" >&2
        dangling=$((dangling + 1))
      }
    done
  done
  if [ "$dangling" -gt 0 ]; then
    failures=$((failures + 1))
  fi

  if [ "$pictures" -eq 0 ]; then
    echo "$name: renders NO pictures -- a web demo that draws nothing is a bug" >&2
    failures=$((failures + 1))
  else
    echo "$name: $pictures picture(s)"
  fi
done

[ "$failures" -eq 0 ] || exit 1
