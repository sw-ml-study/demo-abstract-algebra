# Conformance for lib/algebra.mlpl: the law predicates, the classification
# ladder, and the counterexample witnesses, checked against structures whose
# answers are known independently of this code.
#
# loops: 0

include "lib/algebra.mlpl";

@test {name: "known structures classify correctly", tags: ["laws"]}
def u:test_known_structures() {
  "Every rung of the ladder, one witness each.";
  # Z3 under addition: an abelian group.
  z3 = table(:u:z3_add, u:elements(3), u:elements(3));
  cz3 = u:classify(z3);
  u:assert_eq(cz3.closed, 1, "Z3 not closed")?;
  u:assert_eq(cz3.associative, 1, "Z3 not associative")?;
  u:assert_eq(cz3.commutative, 1, "Z3 not commutative")?;
  u:assert_eq(cz3.identity, 1, "Z3 has no identity")?;
  u:assert_eq(cz3.inverses, 1, "Z3 lacks inverses")?;
  u:assert_eq(cz3.abelian_group, 1, "Z3 is not an abelian group")?;
  u:assert_eq(u:identity_of(z3), 0, "Z3 identity is not 0")?;

  # max on {0,1,2}: associative, commutative, identity 0, but no inverses.
  mx = table(:u:larger_of, u:elements(3), u:elements(3));
  cmx = u:classify(mx);
  u:assert_eq(cmx.monoid, 1, "max is not a monoid")?;
  u:assert_eq(cmx.group, 0, "max should not be a group")?;
  u:assert_eq(u:identity_of(mx), 0, "max identity is not 0")?;

  # Left projection: associative, no identity above order 1.
  lp = table(:u:left_arg, u:elements(3), u:elements(3));
  clp = u:classify(lp);
  u:assert_eq(clp.semigroup, 1, "left projection is not a semigroup")?;
  u:assert_eq(clp.monoid, 0, "left projection should have no identity")?;
  u:assert_eq(clp.commutative, 0, "left projection should not commute")?;
  u:assert_eq(u:identity_of(lp), -1, "missing identity should report -1")?;

  # Rock-paper-scissors: a commutative magma and nothing more.
  rps = [[0, 1, 0], [1, 1, 2], [0, 2, 2]];
  crps = u:classify(rps);
  u:assert_eq(crps.magma, 1, "rps is not a magma")?;
  u:assert_eq(crps.semigroup, 0, "rps should not be associative")?;
  u:assert_eq(crps.commutative, 1, "rps should commute")?;
  ok({test: "known-structures", cases: 14})
}

def u:z3_add(x, y) {
  "Answer the sum modulo 3, an associative operation to contrast against.";
  mod(x + y, 3)
}
def u:larger_of(x, y) {
  "Answer whichever argument is larger.";
  if lt(x, y) {
    y
  } else {
    x
  }
}

@test {name: "counterexamples name a real witness", tags: ["laws"]}
def u:test_counterexamples() {
  "A failed law must exhibit the failing triple.";
  rps = [[0, 1, 0], [1, 1, 2], [0, 2, 2]];
  x = u:assoc_counterexample(rps);
  u:assert_eq(x.found, 1, "rps associativity failure not detected")?;
  # (rock * paper) * scissors = scissors, rock * (paper * scissors) = rock.
  u:assert_eq(x.a, 0, "witness a")?;
  u:assert_eq(x.b, 1, "witness b")?;
  u:assert_eq(x.c, 2, "witness c")?;
  u:assert_eq(x.left, 2, "witness left value")?;
  u:assert_eq(x.right, 0, "witness right value")?;
  # The witness must actually disagree, not merely be reported.
  u:assert_true(1 - eq(x.left, x.right), "witness sides agree")?;

  # An associative table reports no witness.
  z3 = table(:u:z3_add, u:elements(3), u:elements(3));
  y = u:assoc_counterexample(z3);
  u:assert_eq(y.found, 0, "Z3 should have no associativity witness")?;

  # Non-commutative left projection: 0 * 1 = 0 but 1 * 0 = 1.
  lp = table(:u:left_arg, u:elements(3), u:elements(3));
  cx = u:comm_counterexample(lp);
  u:assert_eq(cx.found, 1, "left projection commutativity failure missed")?;
  u:assert_true(1 - eq(cx.left, cx.right), "commutativity witness agrees")?;

  # Closure: an entry outside the element set is caught and located.
  open = [[0, 1], [1, 2]];
  cl = u:closure_counterexample(open);
  u:assert_eq(cl.found, 1, "escape from the set not detected")?;
  u:assert_eq(cl.a, 1, "closure witness row")?;
  u:assert_eq(cl.b, 1, "closure witness column")?;
  u:assert_eq(cl.value, 2, "closure witness value")?;
  u:assert_eq(u:is_closed(open), 0, "open table reported closed")?;
  ok({test: "counterexamples", cases: 15})
}

@test {name: "homomorphisms and isomorphism", tags: ["maps"]}
def u:test_structure_preserving() {
  "Structure-preserving maps between tables.";
  z4 = table(:u:z4_add, u:elements(4), u:elements(4));
  z2 = table(:u:z2_add, u:elements(2), u:elements(2));
  # Parity is a homomorphism Z4 -> Z2.
  parity = [0, 1, 0, 1];
  u:assert_eq(u:is_homomorphism(parity, z4, z2), 1, "parity is a hom")?;
  # A map that is not: send everything but 1 to 0.
  bogus = [0, 1, 1, 1];
  u:assert_eq(u:is_homomorphism(bogus, z4, z2), 0, "bogus map accepted")?;
  b = u:hom_counterexample(bogus, z4, z2);
  u:assert_eq(b.found, 1, "bogus map produced no witness")?;
  u:assert_true(1 - eq(b.left, b.right), "hom witness sides agree")?;
  # The constant map to the identity is always a homomorphism.
  u:assert_eq(u:is_homomorphism([0, 0, 0, 0], z4, z2), 1, "constant map")?;

  # Isomorphism: relabeling a table under a permutation, then back.
  p = [1, 2, 0];
  z3 = table(:u:z3_add, u:elements(3), u:elements(3));
  moved = u:permute_table(z3, p);
  u:assert_eq(u:is_isomorphic_under(z3, moved, p), 1, "permute/compare")?;
  u:assert_eq(u:is_isomorphic_under(z3, z3, [0, 1, 2]), 1, "identity perm")?;
  # Relabeling preserves every law: it is the same structure, renamed.
  u:assert_eq(u:classify(moved).abelian_group, 1, "relabel broke the group")?;
  u:assert_eq(u:is_associative(moved), 1, "relabel broke associativity")?;
  ok({test: "structure-preserving", cases: 9})
}

def u:z4_add(x, y) {
  "Answer the sum modulo 4, the cyclic group of order four.";
  mod(x + y, 4)
}
def u:z2_add(x, y) {
  "Answer the sum modulo 2.";
  mod(x + y, 2)
}

@test {name: "trivial and edge-case orders", tags: ["laws", "edges"]}
def u:test_edges() {
  "Order-1 structures and boundary shapes.";
  # The trivial group: one element, which is its own identity and inverse.
  one = [[0]];
  c = u:classify(one);
  u:assert_eq(c.abelian_group, 1, "trivial structure is not a group")?;
  u:assert_eq(u:identity_of(one), 0, "trivial identity")?;
  u:assert_eq(u:order(one), 1, "trivial order")?;
  # A NON-CLOSED table: associativity is undefined, not false, and asking must
  # not crash. The cube gathers by table entries, so an escaping value would
  # index out of range -- lesson 03 found this the hard way.
  esc = [[0, 1, 2], [1, 2, 3], [2, 3, 4]];
  # ordinary addition on {0,1,2}
  ce = u:classify(esc);
  u:assert_eq(ce.closed, 0, "escaping table reported closed")?;
  u:assert_eq(ce.associative, 0, "associativity on a non-closed table")?;
  u:assert_eq(ce.magma, 0, "a non-closed table is not a magma")?;
  u:assert_eq(u:structure_name(esc), "not-a-magma", "wrong rung")?;
  u:assert_eq(u:assoc_counterexample(esc).found, 0, "witness on a non-closed table")?;
  u:assert_eq(u:closure_counterexample(esc).value, 3, "first escape is 1 + 2 = 3")?;

  # An order-2 constant table: associative, but no identity.
  const0 = [[0, 0], [0, 0]];
  cc = u:classify(const0);
  u:assert_eq(cc.semigroup, 1, "constant table is not a semigroup")?;
  u:assert_eq(cc.identity, 0, "constant table should have no identity")?;
  u:assert_eq(u:has_inverses(const0), 0, "constant table has no inverses")?;
  ok({test: "edges", cases: 12})
}

@test {name: "Latin square is necessary for a group, not sufficient", tags: ["laws"]}
def u:test_latin() {
  "Every group is a Latin square; the converse is false, and this pins the counterexample.";
  z4 = table(:u:z4_add, u:elements(4), u:elements(4));
  kl = table(:u:xor4, u:elements(4), u:elements(4));
  mx = table(:u:larger_of, u:elements(4), u:elements(4));
  rps = [[0, 1, 0], [1, 1, 2], [0, 2, 2]];
  lp = table(:u:left_arg, u:elements(3), u:elements(3));
  u:assert_eq(u:is_latin(z4), u:classify(z4).group, "Z4")?;
  u:assert_eq(u:is_latin(kl), u:classify(kl).group, "Klein")?;
  u:assert_eq(u:is_latin(mx), u:classify(mx).group, "max is a monoid, not a group")?;
  u:assert_eq(u:is_latin(rps), u:classify(rps).group, "rock-paper-scissors")?;
  u:assert_eq(u:is_latin(lp), u:classify(lp).group, "left projection")?;
  # A non-closed table must answer 0 rather than crash, as with associativity.
  u:assert_eq(u:is_latin([[0, 1, 2], [1, 2, 3], [2, 3, 4]]), 0, "non-closed")?;

  # THE COUNTEREXAMPLE. Subtraction modulo 3 is a Latin square and is NOT a
  # group -- no identity, not associative. This repo claimed the two were
  # equivalent until docs/research2.txt caught it; the claim dies here.
  sub = table(:u:sub_mod_3, u:elements(3), u:elements(3));
  u:assert_eq(u:is_latin(sub), 1, "subtraction mod 3 is a Latin square")?;
  u:assert_eq(u:classify(sub).group, 0, "...and is not a group")?;
  u:assert_eq(u:classify(sub).associative, 0, "...not associative")?;
  u:assert_eq(u:has_identity(sub), 0, "...and has no identity")?;
  u:assert_eq(u:structure_name(sub), "magma", "so the ladder puts it at magma")?;
  # A group, however, is ALWAYS a Latin square. That direction holds.
  u:assert_eq(u:is_latin(z4) * u:classify(z4).group, u:classify(z4).group, "group implies Latin")?;
  ok({test: "latin-square", cases: 12})
}

def u:xor4(x, y) {
  "Answer the bitwise exclusive-or, which realizes the Klein four-group.";
  bxor(x, y)
}
def u:sub_mod_3(x, y) {
  "Answer x minus y modulo 3: a Latin square that is not a group.";
  mod(x - y + 3, 3)
}

@test {name: "identity cells and the diagonal", tags: ["laws"]}
def u:test_identity_cells() {
  "The cross covers 2n-1 cells; the diagonal is a*a.";
  mx = table(:u:larger_of, u:elements(3), u:elements(3));
  u:assert_eq(reduce_add(flatten(u:mask_of_identity(mx))), 2 * 3 - 1, "cross size")?;
  # No identity means no cells.
  lp = table(:u:left_arg, u:elements(3), u:elements(3));
  u:assert_eq(reduce_add(flatten(u:mask_of_identity(lp))), 0, "no identity, no cross")?;
  # The diagonal is a * a, read off in order.
  z4 = table(:u:z4_add, u:elements(4), u:elements(4));
  u:assert_true(equal(u:diagonal(z4), [0, 2, 0, 2]), "Z4 diagonal")?;
  kl = table(:u:xor4, u:elements(4), u:elements(4));
  u:assert_true(equal(u:diagonal(kl), [0, 0, 0, 0]), "Klein is all self-inverse")?;
  ok({test: "identity-cells", cases: 4})
}

@test {name: "the order-3 census matches known counts", tags: ["laws", "census"]}
def u:test_census() {
  "Independent numbers: if these drift, the batched machinery is wrong.";
  # These are published counts, not values this code produced. That is the
  # point -- they check the implementation against mathematics rather than
  # against itself.
  u:set_base(3);
  b = u:all_tables(3, 19683);
  u:assert_eq(tally(b), 19683, "3^9 operations")?;
  u:assert_eq(reduce_add(u:batch_associative(b)), 113, "labelled semigroups of order 3")?;
  u:assert_eq(reduce_add(u:batch_group(b)), 3, "labelled group tables of order 3")?;

  perms = [[0,1,2],[0,2,1],[1,0,2],[1,2,0],[2,0,1],[2,1,0]];
  canon = u:canonical_index(b, perms);
  u:assert_eq(u:count_distinct(canon), 3330, "magmas of order 3 up to isomorphism")?;
  u:assert_eq(u:count_distinct(compress(u:batch_associative(b), canon)), 24,
    "semigroups of order 3 up to isomorphism")?;
  u:assert_eq(u:count_distinct(compress(u:batch_group(b), canon)), 1,
    "there is exactly one group of order 3")?;
  # The class count is reachable two ways, and they must agree.
  u:assert_eq(reduce_add(eq(canon, u:elements(19683))), 3330, "canonical fixed points")?;
  ok({test: "order-3-census", cases: 7})
}

@test {name: "cosets partition, and Lagrange holds for every subgroup", tags: ["laws", "cosets"]}
def u:test_cosets() {
  "Cosets tile a group with congruent pieces, so |H| times the index is |G|.";
  z6 = table(:u:z6_add, u:elements(6), u:elements(6));
  evens = u:cyclic_subgroup(z6, 2);
  # The identity's coset IS the subgroup; no other coset is even closed.
  u:assert_true(equal(u:left_coset(z6, 0, evens), evens), "eH is H")?;
  u:assert_eq(u:subset_closed(z6, u:left_coset(z6, 1, evens)), 0, "a shifted coset is not a subgroup")?;
  # Two cosets, three members each, disjoint and covering.
  u:assert_eq(u:coset_count(z6, evens), 2, "index of the evens in Z6")?;
  u:assert_true(equal(u:coset_labels(z6, evens), [0, 1, 0, 1, 0, 1]), "coset labels alternate")?;
  # Lagrange over every subgroup of Z6 and of S3, not just a chosen one.
  u:assert_eq(u:lagrange_failures(z6), 0, "Lagrange holds for all 4 subgroups of Z6")?;
  s3 = u:s3_table();
  u:assert_eq(u:lagrange_failures(s3), 0, "Lagrange holds for all 6 subgroups of S3")?;
  # Normality is a property of the subgroup, not of the group: Z6 is abelian so
  # all 4 are normal, while S3 has exactly 3 -- the trivial one, A3, and itself.
  u:assert_eq(u:normal_subgroup_count(z6), 4, "every subgroup of an abelian group is normal")?;
  u:assert_eq(u:normal_subgroup_count(s3), 3, "S3 has exactly three normal subgroups")?;
  ok({test: "cosets", cases: 8})
}

# Helpers for the coset test. `each` needs a one-argument function, so the group
# under test is parked in a global rather than threaded through.
def u:z6_add(x, y) {
  "Answer the sum modulo 6, the cyclic group of order six.";
  mod(x + y, 6)
}

def u:s3_table() {
  "Answer the Cayley table of S3, built by composing the six permutations of three things.";
  table(:u:s3_compose, u:elements(6), u:elements(6))
}

def u:s3_compose(i, j) {
  "Answer the index of permutation i composed after permutation j.";
  ps = [[0,1,2],[0,2,1],[1,0,2],[1,2,0],[2,0,1],[2,1,0]];
  composed = flatten(gather_rows(reshape(take(ps, 0, i), [3, 1]), take(ps, 0, j)));
  argmax(reduce(:and, eq(ps, gather_rows(reshape(composed, [1, 3]), fill([6], 0))), 1))
}

def u:lagrange_failures(t) {
  "Answer how many subgroups of t violate |H| * index = |G|, which should always be none.";
  global_set("mlpl_test_coset_group", t);
  global_set("mlpl_test_coset_subs", u:all_subgroups(t));
  subs = u:all_subgroups(t);
  reduce_add(1 - each(:u:lagrange_holds_at, u:elements(tally(subs))))
}

def u:lagrange_holds_at(i) {
  "Answer 1 when subgroup i of the pending group satisfies Lagrange.";
  h = take(mlpl_test_coset_subs, 0, i);
  eq(u:subset_size(h) * u:coset_count(mlpl_test_coset_group, h), u:order(mlpl_test_coset_group))
}

def u:normal_subgroup_count(t) {
  "Answer how many subgroups of t have constant coset blocks, which is how many are normal.";
  global_set("mlpl_test_coset_group", t);
  global_set("mlpl_test_coset_subs", u:all_subgroups(t));
  subs = u:all_subgroups(t);
  reduce_add(each(:u:normal_at, u:elements(tally(subs))))
}

def u:normal_at(i) {
  "Answer 1 when subgroup i of the pending group is normal.";
  u:coset_blocks_constant(mlpl_test_coset_group, take(mlpl_test_coset_subs, 0, i))
}

u:run_registered_tests()
