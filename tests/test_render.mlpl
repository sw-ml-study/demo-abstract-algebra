# Conformance for lib/render.mlpl: the string primitives sw-MLPL does not
# supply, and the SVG they build.  These exist because the workarounds in
# docs/upstream-asks.md (#3, #4, #7) rest on incidental behavior of to_json and
# the byte-array round trip; if either drifts, every diagram in this repository
# drifts with it, silently.  This test makes that loud instead.
#
# loops: 0

include "lib/algebra.mlpl";
include "lib/render.mlpl";

@test {name: "string primitives", tags: ["render"]}
def u:test_string_primitives() { "cat and num are the SVG emitter's floor.";
  u:assert_eq(u:cat("ab", "cd"), "abcd", "cat failed")?;
  u:assert_eq(u:cat("", "x"), "x", "cat with empty left")?;
  u:assert_eq(u:cat("x", ""), "x", "cat with empty right")?;
  u:assert_eq(u:cat3("a", "b", "c"), "abc", "cat3 failed")?;
  u:assert_eq(u:cat5("a", "b", "c", "d", "e"), "abcde", "cat5 failed")?;
  # The load-bearing assumption: to_json of a scalar IS its numeral.
  u:assert_eq(u:num(0), "0", "num 0")?;
  u:assert_eq(u:num(12), "12", "num 12")?;
  u:assert_eq(u:num(1.5), "1.5", "num 1.5")?;
  u:assert_eq(u:num(0 - 3), "-3", "num negative")?;
  ok({test: "string-primitives", cases: 9})
}

@test {name: "cayley svg is well formed", tags: ["render"]}
def u:test_cayley_svg() { "Structure and highlights land in the emitted SVG.";
  rps = {
    title: "rps",
    names: ["rock", "paper", "scissors"],
    table: [[0, 1, 0], [1, 1, 2], [0, 2, 2]]
  };
  doc = u:cayley_svg(rps);
  u:assert_true(gt(size(tokenize_bytes(doc)), 500), "svg suspiciously short")?;
  # 3x3 cells + 1 background = 10 rects, and no identity frame: rps has none.
  u:assert_eq(u:count_substr(doc, "<rect"), 10, "wrong rect count")?;
  # 1 title + 3 column headings + 3 row headings + 9 cell labels = 16 texts.
  u:assert_eq(u:count_substr(doc, "<text"), 16, "wrong text count")?;
  u:assert_eq(u:count_substr(doc, "</svg>"), 1, "svg not closed")?;
  u:assert_eq(u:count_substr(doc, "stroke="), 0, "rps drew an identity frame")?;

  # Z3 has an identity, so two frames appear: its row and its column.
  z3 = {
    title: "Z3",
    names: ["0", "1", "2"],
    table: table(:u:z3_add, u:elements(3), u:elements(3))
  };
  z = u:cayley_svg(z3);
  u:assert_eq(u:count_substr(z, "stroke="), 2, "identity cross not drawn")?;
  u:assert_eq(u:count_substr(z, "<rect"), 12, "z3 rect count")?;
  ok({test: "cayley-svg", cases: 7})
}

def u:z3_add(x, y) { mod(x + y, 3) }

# Count occurrences of a needle.  sw-MLPL has no substring search, so this is
# the array formulation: rotate the haystack once per needle byte and AND the
# per-position equalities together.  The recursion is over the NEEDLE, so it is
# a handful of frames deep regardless of document size -- walking the haystack
# byte by byte instead overflows the interpreter's stack outright
# (docs/upstream-asks.md #8).
def u:count_substr(hay, needle) {
  h = tokenize_bytes(hay);
  ndl = tokenize_bytes(needle);
  # A haystack shorter than the needle has no matches, and the rotate-and-mask
  # formulation below would build a zero-length array and fail on it.  The
  # empty document is a real case: assoc_walk_svg returns "" when the operation
  # IS associative.
  if lt(size(h), size(ndl)) { 0 } else { u:count_found(h, ndl) }
}

def u:count_found(h, ndl) {
  n = size(h);
  k = size(ndl);
  hits = u:match_mask(h, ndl, 0, ones([n]));
  # Drop wrap-around matches: a rotation makes the tail see the head.
  reduce_add(hits * lt(range(n), n - k + 1))
}

def u:match_mask(h, ndl, j, acc) {
  if lt(j, size(ndl)) {
    u:match_mask(h, ndl, j + 1, acc * eq(rotate(h, j, 0), take(ndl, 0, j)))
  } else { acc }
}

@test {name: "structure json round trips", tags: ["render", "viewer"]}
def u:test_structure_json() { "The viewer's transport must survive a round trip.";
  rps = {
    title: "rps",
    names: ["rock", "paper", "scissors"],
    table: [[0, 1, 0], [1, 1, 2], [0, 2, 2]]
  };
  text = u:structure_json(rps);
  back = unwrap(parse_json(text));
  u:assert_eq(back.title, "rps", "title lost")?;
  u:assert_eq(back.structure, "magma", "classification lost")?;
  u:assert_eq(back.identity, 0 - 1, "absent identity should encode as -1")?;
  u:assert_true(equal(back.table, rps.table), "table did not round trip")?;
  u:assert_eq(back.laws.associative, 0, "law verdict lost")?;
  u:assert_eq(back.assoc_counterexample.found, 1, "witness lost")?;
  u:assert_eq(back.assoc_counterexample.a, 0, "witness a lost")?;
  ok({test: "structure-json", cases: 7})
}

@test {name: "animated associativity walk", tags: ["render", "animation"]}
def u:test_assoc_walk() { "SMIL markers, and the constraint browsers enforce silently.";
  rps = {
    title: "rps",
    names: ["rock", "paper", "scissors"],
    table: [[0, 1, 0], [1, 1, 2], [0, 2, 2]]
  };
  doc = u:assoc_walk_svg(rps);
  # Two markers, x and y animated on each: four <animate> elements.
  u:assert_eq(u:count_substr(doc, "<animate "), 4, "wrong animate count")?;
  u:assert_eq(u:count_substr(doc, "repeatCount=\"indefinite\""), 4, "not looping")?;
  # values and keyTimes must have EQUAL length or the browser drops the
  # animation with no error at all.  Every animate carries one 4-entry
  # keyTimes and one 4-entry values, so 3 separators each, twice over.
  u:assert_eq(u:count_substr(doc, "keyTimes=\"0;0.35;0.5;1\""), 4, "keyTimes")?;
  u:assert_eq(u:count_substr(doc, ";"), 4 * 3 * 2, "values/keyTimes lengths")?;
  # An ASSOCIATIVE table has no counterexample to walk, so there is no
  # animation to draw and drawing one would be a lie.
  z3 = {
    title: "Z3",
    names: ["0", "1", "2"],
    table: table(:u:z3_add, u:elements(3), u:elements(3))
  };
  u:assert_eq(u:assoc_walk_svg(z3), "", "an associative table has no walk")?;
  u:assert_eq(u:count_substr(u:assoc_walk_svg(z3), "<animate "), 0, "z3 walk")?;
  u:assert_eq(u:count_substr("", "x"), 0, "empty haystack")?;
  u:assert_eq(u:count_substr("ab", "abcd"), 0, "needle longer than haystack")?;
  ok({test: "assoc-walk", cases: 8})
}

@test {name: "dominance digraph reads the table", tags: ["render"]}
def u:test_dominance() { "The graph must agree with the algebra by construction.";
  # RPSLS, ordered so each element beats the next two around the circle.
  s = {
    title: "rpsls",
    names: ["spock", "paper", "lizard", "scissors", "rock"],
    table: table(:u:fight5, u:elements(5), u:elements(5))
  };
  doc = u:dominance_svg(s);
  # Ten wins in RPSLS: five elements, each beating exactly two others.
  u:assert_eq(u:count_substr(doc, "<line "), 10, "wrong edge count")?;
  u:assert_eq(u:count_substr(doc, "<circle "), 5, "wrong node count")?;
  u:assert_eq(u:count_substr(doc, "marker-end="), 10, "edges are not directed")?;
  u:assert_eq(u:count_substr(doc, "<marker "), 1, "arrowhead defined once")?;
  # A commutative-but-not-winner table still draws: RPS has 3 wins.
  rps = {title: "rps", names: ["rock", "paper", "scissors"],
         table: [[0, 1, 0], [1, 1, 2], [0, 2, 2]]};
  u:assert_eq(u:count_substr(u:dominance_svg(rps), "<line "), 3, "rps edges")?;
  ok({test: "dominance", cases: 5})
}

def u:gap5(x, y) { mod(x - y + 5, 5) }
def u:beats5(x, y) { lt(u:gap5(x, y) - 1, 2) * (1 - eq(u:gap5(x, y), 0)) }
def u:fight5(x, y) { if u:beats5(x, y) { x } else { y } }

u:run_registered_tests()
