# Lesson 14 -- Subgroups: the groups hiding inside a group.
#
# Meaning here: a SUBGROUP is a subset of a group that is itself a group under
# the same operation. In a FINITE group that reduces to one condition -- the
# subset is non-empty and closed -- because repeated multiplication cycles, so
# the identity and inverses arrive on their own.
# Also called: nothing else. But note the collision with "subset", which is
# the weaker notion: every subgroup is a subset, almost no subset is a
# subgroup. Z6 has 64 subsets and 4 subgroups.
# Not to be confused with: "semigroup", which sounds similar and is a
# different idea entirely -- lesson 05.
#
# This opens Stage 2. Stage 1 asked what laws a whole operation obeys. From
# here the question is what a single group CONTAINS, and the answers are
# visible as regions of its own table.
#
# NOT a Web UI file. This is a CLI lesson: it uses include and write_text,
# neither of which the browser session has, and it ends in ok(...) so the
# suite can gate on it. See docs/viewing.md.
#
# visual: ascii, svg
# loops: 0
# complexity: 2^n subsets tested, each in n^2 array operations

include "../../lib/algebra.mlpl"
include "../../lib/render.mlpl"

u:prolog({
  title: "LESSON 14 -- SUBGROUPS: the groups hiding inside a group",
  intro: "Stage 2 opens by looking inward. A subgroup is a subset closed under the operation, which shows up as a square block of the table that is a complete Cayley table in its own right. This lesson finds every subgroup of two groups by testing all 2^n subsets, and notices something about their sizes that the next lesson turns into a theorem."
})

def u:add_mod_6(x, y) { "Answer the sum modulo 6."; mod(x + y, 6) }
z6 = {
  title: "Z6 under addition",
  names: ["0", "1", "2", "3", "4", "5"],
  table: table(:u:add_mod_6, u:elements(6), u:elements(6))
}

u:show_table(z6)
print("")
print("rung:", u:structure_name(z6.table))

# --- Order of an element ----------------------------------------------------
# How many times must you apply an element to itself before the identity comes
# back? That count is the element's ORDER, and it is the size of the smallest
# subgroup containing it.
def u:order_of(a) { "Answer the order of element a in Z6."; u:element_order(z6.table, a) }
orders = each(:u:order_of, u:elements(6))
print("")
print("element:        ", z6.names)
print("order:          ", orders)
print("  0 is the identity, so its order is 1. Elements 1 and 5 take six steps")
print("  to come back -- they generate everything. 3 takes two, 2 and 4 take three.")
print("  Every order divides 6, and that is not a coincidence.")

# --- The subgroup an element generates --------------------------------------
gen2 = u:cyclic_subgroup(z6.table, 2)
gen3 = u:cyclic_subgroup(z6.table, 3)
gen1 = u:cyclic_subgroup(z6.table, 1)
print("")
print("the subgroup generated by 2:", gen2, " size", u:subset_size(gen2))
print("the subgroup generated by 3:", gen3, " size", u:subset_size(gen3))
print("the subgroup generated by 1:", gen1, " size", u:subset_size(gen1))
print("  <1> is everything, so 1 GENERATES Z6 -- which is what 'cyclic' means.")
print("  size of <a> equals the order of a:",
      u:yes_or_no(eq(u:subset_size(gen2), u:element_order(z6.table, 2))))

# --- Every subgroup, found by exhaustion ------------------------------------
# 2^6 = 64 subsets. Testing all of them is the same digit-extraction idiom as
# lesson 10: a subset is an n-bit numeral, so all of them are one array.
subs = u:all_subgroups(z6.table)
sizes = reduce_add(subs, 1)
print("")
print("subsets of Z6:", tally(u:all_subsets(6)), "  subgroups:", tally(subs))
print(disp(subs))
print("sizes:", sizes)
print("  Four subgroups, of sizes 1, 2, 3 and 6 -- exactly the divisors of 6.")
print("  Sizes 4 and 5 do not appear, and no amount of searching would find them.")

# --- A non-abelian example --------------------------------------------------
# S3 has more subgroups and they are not all cyclic-looking, but the sizes
# behave the same way.
perms = [[0, 1, 2], [0, 2, 1], [1, 0, 2], [1, 2, 0], [2, 0, 1], [2, 1, 0]]
def u:after(a, b) { "Answer the permutation a-after-b."; flatten(gather_rows(reshape(a, [3, 1]), b)) }
def u:which_perm(p) { "Answer which of the six permutations p is."; argmax(reduce(:and, eq(perms, gather_rows(reshape(p, [1, 3]), fill([6], 0))), 1)) }
def u:compose(i, j) { "Answer the index of permutation i composed after permutation j."; u:which_perm(u:after(take(perms, 0, i), take(perms, 0, j))) }
s3 = {
  title: "S3, the symmetries of a triangle",
  names: ["e", "s", "t", "r", "r2", "u"],
  table: table(:u:compose, u:elements(6), u:elements(6))
}
s3_subs = u:all_subgroups(s3.table)
s3_sizes = reduce_add(s3_subs, 1)
print("")
print("S3 subgroups:", tally(s3_subs), " sizes:", s3_sizes)
print("  Six subgroups where Z6 had four, and the same group order. Being")
print("  non-abelian changes how much sits inside, not which sizes are allowed.")

# --- The diagrams -----------------------------------------------------------
a = u:write_marked_svg("out/14-subgroup-block.svg", z6, u:subset_cells(gen2),
  "ringed: the subgroup generated by 2")
b = u:write_marked_svg("out/14-generated.svg", z6, u:subset_cells(gen3),
  "ringed: the subgroup generated by 3")

u:epilog_open()

u:explain("out/14-subgroup-block.svg",
  "The 6x6 table for Z6, with the subgroup {0, 2, 4} ringed.")
u:note("Nine cells are ringed: every pairing of two members. Rows 0, 2, 4 crossed with")
u:note("columns 0, 2, 4.")
u:note("WHAT TO NOTICE: the ringed cells are scattered rather than a solid block, because")
u:note("the members are not adjacent -- but they are a complete 3x3 Cayley table hiding")
u:note("inside the 6x6 one, and every value in them is another member. That closure is")
u:note("the entire definition of a subgroup.")
u:note("Read only the ringed cells and you are reading Z3, relabelled.")

u:explain("out/14-generated.svg",
  "The same table with the subgroup {0, 3} ringed: four cells.")
u:note("WHAT TO NOTICE: 3 + 3 = 0, so the pair closes on itself immediately. This is the")
u:note("smallest subgroup other than {0}, and it exists because 6 is even.")
u:note("Compare the two pictures: nine ringed cells and four, so the subgroups have 3 and")
u:note("2 members -- and 3 and 2 both divide 6. The next lesson explains why they must.")

u:limits("Every subgroup here was found by testing all 2^n subsets, which is honest but does not scale: a group of order 12 has 4,096 subsets and order 20 has over a million. Nothing here proves the sizes MUST divide the group order either -- six examples are not a theorem, and the argument is lesson 15. And the closed-subset shortcut used to test subgroups is only valid because these groups are finite; in an infinite group closure alone is not enough.")

u:takeaway("A subgroup is a subset closed under the operation, and in a finite group that single condition is the whole definition -- the identity and inverses follow because repeated multiplication has nowhere else to go. Read only the ringed cells of the picture and you are reading a smaller Cayley table, complete in itself. The sizes that turn up are 1, 2, 3 and 6 for a group of order 6, and never 4 or 5, which is the pattern the next lesson makes into Lagrange's theorem.")

print("wrote out/14-subgroup-block.svg:", is_ok(a))
print("wrote out/14-generated.svg:", is_ok(b))

# --- Invariants -------------------------------------------------------------
# The order of an element is the size of the subgroup it generates.
order_a = eq(u:subset_size(gen2), u:element_order(z6.table, 2))
order_matches = order_a * eq(u:subset_size(gen3), u:element_order(z6.table, 3))
cyclic = eq(u:subset_size(gen1), 6)
# Z6 has exactly the four subgroups whose sizes are the divisors of 6.
counts = eq(tally(subs), 4) * equal(sizes, [1, 2, 3, 6])
# S3 has six, of sizes 1, 2, 2, 2, 3, 6.
s3_ok = eq(tally(s3_subs), 6) * eq(reduce_add(s3_sizes), 16)
# Every subgroup found really is closed.
def u:closed_at(i) { "Answer 1 when subgroup i of the found set is closed."; u:subset_closed(z6.table, take(subs, 0, i)) }
all_closed = reduce(:and, each(:u:closed_at, u:elements(tally(subs))))
if order_matches * cyclic * counts * s3_ok * all_closed * is_ok(a) * is_ok(b) {
  ok("subgroups are closed subsets; their sizes divide the group order")
} else {
  err("subgroup invariants failed")
}
