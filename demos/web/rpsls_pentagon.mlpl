# Rock-Paper-Scissors-Lizard-Spock: the pentagram -- a Web UI demo.
# visual: svg
# loops: 0
# **************************************************************************
# * WHAT THIS SHOWS
# *
# * Rock-Paper-Scissors-Lizard-Spock has ten rules but only one idea:
# * arrange the five choices in a circle, and each beats the NEXT TWO going
# * around. Two pictures of that fact -- the arrows, and the operation as an
# * table -- and the table itself is in latin_square.mlpl.
# **************************************************************************
;
def u:beats(x, y) { lt(mod(x - y + 5, 5) - 1, 2) * (1 - eq(mod(x - y + 5, 5), 0)) }  # beats the next two around
def u:fight(x, y) { if u:beats(x, y) { x } else { y } }  # spock 0 .. rock 4
def u:cat(a, b) { decode_bytes(concat(tokenize_bytes(a), tokenize_bytes(b))) }  # plumbing: no graph type
def u:nm(v) { unwrap(to_json(round(v))) }
def u:px(i, k) { 190 + 130 * cos(2 * pi() * i / k - pi() / 2) }
def u:py(i, k) { 190 + 130 * sin(2 * pi() * i / k - pi() / 2) }
def u:ex(a, b, k, f) { u:px(a, k) + (u:px(b, k) - u:px(a, k)) * f }
def u:ey(a, b, k, f) { u:py(a, k) + (u:py(b, k) - u:py(a, k)) * f }
def u:seg(a, b, k) { u:cat(u:cat(u:cat("<line x1=\"", u:nm(u:ex(a, b, k, 0.24))), u:cat("\" y1=\"", u:nm(u:ey(a, b, k, 0.24)))), u:cat(u:cat(u:cat("\" x2=\"", u:nm(u:ex(a, b, k, 0.76))), u:cat("\" y2=\"", u:nm(u:ey(a, b, k, 0.76)))), "\" stroke=\"#7aa2f7\" stroke-width=\"3\" marker-end=\"url(#a)\"/>")) }
def u:dot(i, k, nm) { u:cat(u:cat(u:cat("<circle cx=\"", u:nm(u:px(i, k))), u:cat("\" cy=\"", u:nm(u:py(i, k)))), u:cat("\" r=\"37\" fill=\"#f7768e\"/>", u:cat(u:cat(u:cat("<text x=\"", u:nm(u:px(i, k))), u:cat("\" y=\"", u:nm(u:py(i, k)))), u:cat(u:cat("\" fill=\"#12131c\" text-anchor=\"middle\" dominant-baseline=\"central\" font-size=\"12\" font-family=\"monospace\">", unwrap(list_get(nm.names, i))), "</text>")))) }
def u:arrows(i, k, acc) { if lt(i, k * k) { u:arrows(i + 1, k, if u:beats(floor(i / k), mod(i, k)) { u:cat(acc, u:seg(floor(i / k), mod(i, k), k)) } else { acc }) } else { acc } }
def u:nodes(i, k, nm, acc) { if lt(i, k) { u:nodes(i + 1, k, nm, u:cat(acc, u:dot(i, k, nm))) } else { acc } }
def u:cycle(k, nm) { u:cat(u:cat("<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 380 380\"><rect width=\"100%\" height=\"100%\" fill=\"#1a1b26\"/><defs><marker id=\"a\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"5\" markerHeight=\"5\" orient=\"auto-start-reverse\"><path d=\"M 0 0 L 10 5 L 0 10 z\" fill=\"#7aa2f7\"/></marker></defs>", u:arrows(0, k, "")), u:cat(u:nodes(0, k, nm, ""), "</svg>")) }
# **************************************************************************
# * THE BEATS GRAPH
# *
# * Five circles on a ring: spock, paper, lizard, scissors, rock, going
# * clockwise from the top. An arrow a -> b means "a beats b".
# *
# * Count the arrows at any circle: two leave and two arrive. Every choice
# * wins twice and loses twice, and that balance is why the game is fair.
# **************************************************************************
u:cycle(5, {names: ["spock", "paper", "lizard", "scissors", "rock"]})
# **************************************************************************
# * WHAT TO NOTICE
# *
# * WHY IT IS A STAR. Each choice beats the two AFTER it, not the one beside
# * it, so no arrow follows the rim of the circle -- every one cuts across.
# * Ten arrows cutting across five points draw the pentagram. The star is not
# * decoration: it is the shape of "beats the next two".
# *
# * THE POINT -- the arrows and the table are one object, not two. Growing
# * from three choices to five added rules but no LAWS: this is still a
# * magma. Not associative, no identity, no inverses.
# **************************************************************************
