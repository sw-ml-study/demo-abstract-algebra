# Rock-Paper-Scissors-Lizard-Spock: the pentagram -- a Web UI demo.
# visual: svg
# loops: 0
# **************************************************************************
# * WHAT THIS SHOWS
# *
# * Rock-Paper-Scissors-Lizard-Spock has ten rules but only one idea:
# * arrange the five choices in a circle, and each beats the NEXT TWO going
# * around. Two pictures of that fact -- the arrows, and the operation as an
# * table -- and the table itself is in latin_square.mlpl.
# **************************************************************************
;
def u:beats_in_game(x, y) { "Answer 1 when x beats y, which is the whole rulebook in one modular test."; lt(mod(x - y + 5, 5) - 1, 2) * (1 - eq(mod(x - y + 5, 5), 0)) }  # beats the next two around
def u:winner_of(x, y) { "Answer the winner of a matchup; a tie answers the shared choice."; if u:beats_in_game(x, y) { x } else { y } }  # spock 0 .. rock 4
def u:element_color(i) { "Answer the colour that stands for element i, shared by the graph and the table."; unwrap(list_get(["#7aa2f7", "#f7768e", "#9ece6a", "#e0af68", "#bb9af7"], mod(i, 5))) }  # same palette as the tables
def u:node_x(i, k) { "Answer the x position of node i on a circle of k nodes, element 0 at the top."; 190 + 130 * cos(2 * pi() * i / k - pi() / 2) }
def u:node_y(i, k) { "Answer the y position of node i on a circle of k nodes."; 190 + 130 * sin(2 * pi() * i / k - pi() / 2) }
def u:along_x(a, b, k, f) { "Answer the x coordinate a fraction f of the way from node a to node b."; u:node_x(a, k) + (u:node_x(b, k) - u:node_x(a, k)) * f }
def u:along_y(a, b, k, f) { "Answer the y coordinate a fraction f of the way from node a to node b."; u:node_y(a, k) + (u:node_y(b, k) - u:node_y(a, k)) * f }
def u:arrow(a, b, k) { "Answer one arrow from a to b, stopped short of both nodes so the head stays visible."; str_concat(str_concat(str_concat("<line x1=\"", to_string(u:along_x(a, b, k, 0.24))), str_concat("\" y1=\"", to_string(u:along_y(a, b, k, 0.24)))), str_concat(str_concat(str_concat("\" x2=\"", to_string(u:along_x(a, b, k, 0.76))), str_concat("\" y2=\"", to_string(u:along_y(a, b, k, 0.76)))), "\" stroke=\"#7aa2f7\" stroke-width=\"3\" marker-end=\"url(#a)\"/>")) }
def u:node(i, k, names) { "Answer one labelled coloured circle for element i."; str_concat(str_concat(str_concat("<circle cx=\"", to_string(u:node_x(i, k))), str_concat("\" cy=\"", to_string(u:node_y(i, k)))), str_concat(str_concat(str_concat("\" r=\"37\" fill=\"", u:element_color(i)), "\"/>"), str_concat(str_concat(str_concat("<text x=\"", to_string(u:node_x(i, k))), str_concat("\" y=\"", to_string(u:node_y(i, k)))), str_concat(str_concat("\" fill=\"#12131c\" text-anchor=\"middle\" dominant-baseline=\"central\" font-size=\"12\" font-family=\"monospace\">", unwrap(list_get(names, i))), "</text>")))) }
def u:all_arrows(i, k, acc) { "Answer an arrow for every ordered pair where the first beats the second."; if lt(i, k * k) { u:all_arrows(i + 1, k, if u:beats_in_game(floor(i / k), mod(i, k)) { str_concat(acc, u:arrow(floor(i / k), mod(i, k), k)) } else { acc }) } else { acc } }
def u:all_nodes(i, k, names, acc) { "Answer a circle for every element."; if lt(i, k) { u:all_nodes(i + 1, k, names, str_concat(acc, u:node(i, k, names))) } else { acc } }
def u:beats_graph(k, names) { "Answer the whole beats relation drawn as a directed graph. sw-MLPL has no graph renderer."; str_concat(str_concat("<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 380 380\" width=\"380\" height=\"380\"><rect width=\"100%\" height=\"100%\" fill=\"#1a1b26\"/><defs><marker id=\"a\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"5\" markerHeight=\"5\" orient=\"auto-start-reverse\"><path d=\"M 0 0 L 10 5 L 0 10 z\" fill=\"#7aa2f7\"/></marker></defs>", u:all_arrows(0, k, "")), str_concat(u:all_nodes(0, k, names, ""), "</svg>")) }
# **************************************************************************
# * THE BEATS GRAPH
# *
# * Five circles on a ring: spock, paper, lizard, scissors, rock, going
# * clockwise from the top. An arrow a -> b means "a beats b".
# *
# * Count the arrows at any circle: two leave and two arrive. Every choice
# * wins twice and loses twice, and that balance is why the game is fair.
# **************************************************************************
u:beats_graph(5, ["spock", "paper", "lizard", "scissors", "rock"])
# **************************************************************************
# * WHAT TO NOTICE
# *
# * WHY IT IS A STAR. Each choice beats the two AFTER it, not the one beside
# * it, so no arrow follows the rim of the circle -- every one cuts across.
# * Ten arrows cutting across five points draw the pentagram. The star is not
# * decoration: it is the shape of "beats the next two".
# *
# * THE POINT -- the arrows and the table are one object, not two. Growing
# * from three choices to five added rules but no LAWS: this is still a
# * magma. Not associative, no identity, no inverses.
# **************************************************************************
