# Web entry -- Rock-Paper-Scissors: associativity failing, animated.
#
# Two markers walk the two bracketings of (rock * paper) * scissors and
# rock * (paper * scissors), and land on different colors.  The animation is
# SMIL, which is text like the rest of the SVG -- no encoder, no GIF, no new
# language capability.
#
# The FINAL VALUE is the SVG string, so the browser REPL renders it inline.
#
# visual: svg
# loops: 0

include "../../lib/algebra.mlpl"
include "../../lib/render.mlpl"

def u:beats(x, y) { eq(mod(x - y + 3, 3), 1) }
def u:fight(x, y) { if u:beats(x, y) { x } else { y } }

u:assoc_walk_svg({
  title: "Rock-Paper-Scissors: associativity fails",
  names: ["rock", "paper", "scissors"],
  table: table(:u:fight, u:elements(3), u:elements(3))
})
