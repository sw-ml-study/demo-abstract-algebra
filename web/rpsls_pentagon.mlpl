# Rock-Paper-Scissors-Lizard-Spock: the pentagram -- paste into the playground.
# visual: svg
# loops: 0
# Order the five so each beats the NEXT TWO around a circle. Ten rules
# collapse to one modular predicate, and the picture is why.
# spock 0, paper 1, lizard 2, scissors 3, rock 4
def u:beats(x, y) { lt(mod(x - y + 5, 5) - 1, 2) * (1 - eq(mod(x - y + 5, 5), 0)) }
def u:fight(x, y) { if u:beats(x, y) { x } else { y } }
t = table(:u:fight, range(5), range(5))
# Wins per element: each beats exactly two others. A fair tournament.
def u:won(x, y) { u:beats(x, y) }
reduce_add(table(:u:won, range(5), range(5)), 1)
# Frame k lights the cells whose winner is k. Five lit cells each,
# and the pattern rotates -- the five-fold symmetry, animated.
svg(reshape(transpose(one_hot(flatten(t), 5)), [5, 5, 5]), "life")
# svg() has no graph type, so the pentagram is emitted by hand. That gap
# is the forcing function: a "digraph" type would delete everything below.
def u:cat(a, b) { decode_bytes(concat(tokenize_bytes(a), tokenize_bytes(b))) }
def u:n(v) { unwrap(to_json(round(v))) }
def u:px(i) { 250 + 175 * cos(2 * pi() * i / 5 - pi() / 2) }
def u:py(i) { 250 + 175 * sin(2 * pi() * i / 5 - pi() / 2) }
def u:seg(a, b) { u:cat(u:cat(u:cat("<line x1=\"", u:n(u:px(a))), u:cat("\" y1=\"", u:n(u:py(a)))), u:cat(u:cat("\" x2=\"", u:n(u:px(b))), u:cat(u:cat("\" y2=\"", u:n(u:py(b))), "\" stroke=\"#7aa2f7\" stroke-width=\"3\"/>"))) }
def u:dot(i) { u:cat(u:cat(u:cat("<circle cx=\"", u:n(u:px(i))), u:cat("\" cy=\"", u:n(u:py(i)))), "\" r=\"26\" fill=\"#f7768e\"/>") }
def u:edges(i, acc) { if lt(i, 25) { u:edges(i + 1, if u:beats(floor(i / 5), mod(i, 5)) { u:cat(acc, u:seg(floor(i / 5), mod(i, 5))) } else { acc }) } else { acc } }
def u:dots(i, acc) { if lt(i, 5) { u:dots(i + 1, u:cat(acc, u:dot(i))) } else { acc } }
u:cat(u:cat("<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 500 500\"><rect width=\"100%\" height=\"100%\" fill=\"#1a1b26\"/>", u:edges(0, "")), u:cat(u:dots(0, ""), "</svg>"))
