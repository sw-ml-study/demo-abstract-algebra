# GENERATED by scripts/build-web-demos from demos/web/rpsls_dominance_web.mlpl
# Do not edit. Edit the source, then run `just web`.
#
# Standalone: every include has been spliced in, because the sw-MLPL
# browser session rejects include. Paste or upload this whole file into
# the Web UI editor; its final value is an SVG, which renders inline.

# Web entry -- Rock-Paper-Scissors-Lizard-Spock as a dominance digraph.
#
# a -> b when a * b = a and a is not b, read straight off the Cayley table, so
# the picture cannot disagree with the algebra.  Every node has out-degree 2
# and in-degree 2; the drawing is the pentagram.
#
# The FINAL VALUE is the SVG string, so the browser REPL renders it inline.
#
# visual: svg
# loops: 0

# ---- spliced from ../../lib/algebra.mlpl ----
# lib/algebra.mlpl -- finite algebraic structures as arrays.
#
# A finite binary operation on n elements IS an n x n Cayley table T, where
# T[a, b] is the index of a * b.  Every law in this repository is therefore an
# array predicate over T, checked without an explicit loop.
#
# Element identity is the index 0 .. n-1 throughout; human names live beside
# the table in a string list, never inside it.
#
# loops: 0

# ---------------------------------------------------------------------------
# Construction
# ---------------------------------------------------------------------------

# The [n] header vector 0 .. n-1: the element indices, and the row/column
# headings of every Cayley table.
def u:elements(n) { range(n) }

# Element index count for a table.
def u:order(t) { tally(t) }

# The [n, n] matrix whose every row is the header (H[a, b] = b).  sw-MLPL
# broadcasts SCALARS only, so a rank-1 header cannot be compared against a
# rank-2 table directly; this materializes it.  See docs/upstream-asks.md #2.
def u:second(x, y) { y }
def u:header_matrix(n) { table(:u:second, u:elements(n), u:elements(n)) }

# The [n, n] matrix whose every column is the header (K[a, b] = a).
def u:first(x, y) { x }
def u:index_matrix(n) { table(:u:first, u:elements(n), u:elements(n)) }

# ---------------------------------------------------------------------------
# The two associativity cubes
# ---------------------------------------------------------------------------
#
# These are the whole trick.  For a table T of order n:
#
#   left_cube(T)[a, b, c]  = T[T[a, b], c]   -- (a * b) * c
#   right_cube(T)[a, b, c] = T[a, T[b, c]]   -- a * (b * c)
#
# gather_rows(T, flatten(T)) indexes T by every entry of T at once, producing
# the [n*n, n] matrix whose (a*n + b, c) cell is T[T[a, b], c].  Reshaping to
# [n, n, n] is the left cube.  The right cube is the same gather against the
# transpose, which yields axes in (b, c, a) order and is permuted back.
#
# All n^3 triples, no loop.

def u:left_cube(t) {
  n = u:order(t)
  reshape(gather_rows(t, flatten(t)), [n, n, n])
}

def u:right_cube(t) {
  n = u:order(t)
  reshape(gather_rows(transpose(t), flatten(t)), [n, n, n])
}

# The [n, n, n] 0/1 cube: 1 where the two bracketings agree.
def u:assoc_cube(t) {
  eq(u:left_cube(t), transpose_axes(u:right_cube(t), [2, 0, 1]))
}

# ---------------------------------------------------------------------------
# Law predicates -- each returns scalar 1 or 0
# ---------------------------------------------------------------------------

# Closure: every entry names a real element.  No ge/le builtins exist, so
# "not below zero" is spelled 1 - lt(...).  See docs/upstream-asks.md #1.
def u:is_closed(t) {
  n = u:order(t)
  reduce(:and, flatten((1 - lt(t, 0)) * lt(t, n) * eq(t, floor(t))))
}

def u:is_associative(t) { reduce(:and, flatten(u:assoc_cube(t))) }

def u:is_commutative(t) { equal(t, transpose(t)) }

# ---------------------------------------------------------------------------
# Identity and inverses
# ---------------------------------------------------------------------------

# [n] mask: 1 at each two-sided identity.  Element e is an identity when row e
# reproduces the header AND column e does too.
def u:identity_mask(t) {
  h = u:header_matrix(u:order(t))
  reduce(:and, eq(t, h), 1) * reduce(:and, eq(transpose(t), h), 1)
}

def u:has_identity(t) { reduce(:or, u:identity_mask(t)) }

# The identity element index, or -1 when there is none.  A monoid's identity
# is unique, so argmax over the mask is exact.
def u:identity_of(t) {
  m = u:identity_mask(t)
  argmax(m) * reduce(:or, m) - (1 - reduce(:or, m))
}

# [n, n] mask: 1 where a * b equals the identity, i.e. b is a right inverse of
# a.  Meaningless without an identity, so it is gated to the zero matrix.
def u:inverse_mask(t) {
  e = u:identity_of(t)
  eq(t, e) * u:has_identity(t)
}

# [n] mask: 1 at each element with a two-sided inverse.
def u:invertible_mask(t) {
  right = reduce(:or, u:inverse_mask(t), 1)
  left = reduce(:or, u:inverse_mask(t), 0)
  right * left
}

def u:has_inverses(t) { reduce(:and, u:invertible_mask(t)) }

# ---------------------------------------------------------------------------
# Classification -- the ladder is DERIVED, never declared
# ---------------------------------------------------------------------------

# Rungs, as a record of 0/1 flags.  A structure is whatever its laws say it is.
def u:classify(t) {
  closed = u:is_closed(t)
  assoc = u:is_associative(t)
  ident = u:has_identity(t)
  inv = u:has_inverses(t)
  comm = u:is_commutative(t)
  {
    closed: closed,
    associative: assoc,
    commutative: comm,
    identity: ident,
    inverses: inv,
    magma: closed,
    semigroup: closed * assoc,
    monoid: closed * assoc * ident,
    group: closed * assoc * ident * inv,
    abelian_group: closed * assoc * ident * inv * comm
  }
}

# The highest rung reached, as a name.
def u:structure_name(t) {
  c = u:classify(t)
  unwrap(list_get(
    ["not-a-magma", "magma", "semigroup", "monoid", "group", "abelian group"],
    c.magma + c.semigroup + c.monoid + c.group + c.abelian_group))
}

# ---------------------------------------------------------------------------
# Counterexamples -- a failed law must name a witness, never just say "no"
# ---------------------------------------------------------------------------

# The first (a, b, c) triple where the two bracketings disagree, as the record
# {found, a, b, c, left, right}.  Lexicographic first, so the witness is stable.
def u:assoc_counterexample(t) {
  n = u:order(t)
  cube = u:assoc_cube(t)
  flat = flatten(cube)
  found = 1 - reduce(:and, flat)
  # grade_up is a STABLE ascending argsort, so entry 0 is the lowest-indexed
  # zero whenever any zero exists.
  i = take(grade_up(flat), 0, 0) * found
  a = floor(i / (n * n))
  b = floor(mod(i, n * n) / n)
  c = mod(i, n)
  {
    found: found,
    a: a,
    b: b,
    c: c,
    ab: take(take(t, 0, a), 0, b),
    bc: take(take(t, 0, b), 0, c),
    left: take(take(take(u:left_cube(t), 0, a), 0, b), 0, c),
    right: take(take(take(transpose_axes(u:right_cube(t), [2, 0, 1]), 0, a), 0, b), 0, c)
  }
}

# The first (a, b) pair where a * b differs from b * a.
def u:comm_counterexample(t) {
  n = u:order(t)
  agree = eq(t, transpose(t))
  flat = flatten(agree)
  found = 1 - reduce(:and, flat)
  i = take(grade_up(flat), 0, 0) * found
  a = floor(i / n)
  b = mod(i, n)
  {
    found: found,
    a: a,
    b: b,
    left: take(take(t, 0, a), 0, b),
    right: take(take(t, 0, b), 0, a)
  }
}

# The first entry that escapes the element set, as {found, a, b, value}.
def u:closure_counterexample(t) {
  n = u:order(t)
  inside = (1 - lt(t, 0)) * lt(t, n) * eq(t, floor(t))
  flat = flatten(inside)
  found = 1 - reduce(:and, flat)
  i = take(grade_up(flat), 0, 0) * found
  a = floor(i / n)
  b = mod(i, n)
  {found: found, a: a, b: b, value: take(take(t, 0, a), 0, b)}
}

# ---------------------------------------------------------------------------
# Structure-preserving maps
# ---------------------------------------------------------------------------
#
# f : M -> N given as an [m] vector of target indices.  f is a homomorphism
# when f(a *M b) = f(a) *N f(b) for every a, b in M.  Both sides are [m, m]
# matrices, so the check is one comparison.

# Rename every ENTRY of a table through the map p: out[a, b] = p[t[a, b]].
def u:apply_names(t, p) {
  reshape(gather_rows(reshape(p, [tally(p), 1]), flatten(t)), shape(t))
}

# Re-index both AXES of a table through the map idx:
#   out[a, b] = t[idx[a], idx[b]]
# With idx of length m this narrows or widens an [n, n] table to [m, m], which
# is what a homomorphism's right-hand side needs.
def u:gather2(t, idx) {
  transpose(gather_rows(transpose(gather_rows(t, idx)), idx))
}

# f : M -> N is a homomorphism when f(a *M b) = f(a) *N f(b) everywhere.
# Left side renames the entries of M's table; right side re-indexes N's table.
def u:hom_lhs(f, s) { u:apply_names(s, f) }
def u:hom_rhs(f, t) { u:gather2(t, f) }
def u:is_homomorphism(f, s, t) { equal(u:hom_lhs(f, s), u:hom_rhs(f, t)) }

# The first (a, b) pair where a candidate map fails to preserve the operation.
def u:hom_counterexample(f, s, t) {
  m = tally(f)
  agree = eq(u:hom_lhs(f, s), u:hom_rhs(f, t))
  flat = flatten(agree)
  found = 1 - reduce(:and, flat)
  i = take(grade_up(flat), 0, 0) * found
  a = floor(i / m)
  b = mod(i, m)
  {
    found: found,
    a: a,
    b: b,
    left: take(take(u:hom_lhs(f, s), 0, a), 0, b),
    right: take(take(u:hom_rhs(f, t), 0, a), 0, b)
  }
}

# Relabel a table under the permutation p (p[i] is the new name of element i).
# For a permutation, grade_up(p) IS the inverse permutation.
# Two tables are isomorphic exactly when some permutation makes them equal.
def u:permute_table(t, p) { u:apply_names(u:gather2(t, grade_up(p)), p) }

def u:is_isomorphic_under(s, t, p) { equal(u:permute_table(s, p), t) }
# ---- end ../../lib/algebra.mlpl ----

# ---- spliced from ../../lib/render.mlpl ----
# lib/render.mlpl -- turning Cayley tables into things a learner can look at.
#
# THE STRUCTURE RECORD.  Every renderer here takes one argument:
#
#   s = {title: "Rock-Paper-Scissors", names: ["rock", ...], table: t}
#
# That is not decoration.  sw-MLPL refuses a string-list as a `u:` function
# argument, but accepts one inside a record, so bundling is the only way to
# hand element names to a helper (docs/upstream-asks.md #6).
#
# sw-MLPL also has no string concatenation operator and no number-to-string
# builtin, so both are constructed here from the primitives that do exist:
#
#   concat: decode_bytes(concat(tokenize_bytes(a), tokenize_bytes(b)))
#   number: unwrap(to_json(x))         -- to_json of a scalar IS its digits
#
# Both are recorded as friction in docs/upstream-asks.md (#3, #4) and are
# confined to this file so lesson scripts stay readable.
#
# The built-in svg(t, "heatmap") colors a table but draws no headings, no cell
# values, and no highlights, which is most of what teaches (upstream ask #5).
# cayley_svg below emits its own SVG instead.
#
# loops: 0

# ---------------------------------------------------------------------------
# String primitives
# ---------------------------------------------------------------------------

def u:cat(a, b) { decode_bytes(concat(tokenize_bytes(a), tokenize_bytes(b))) }
def u:cat3(a, b, c) { u:cat(a, u:cat(b, c)) }
def u:cat5(a, b, c, d, e) { u:cat(u:cat3(a, b, c), u:cat(d, e)) }
def u:num(x) { unwrap(to_json(x)) }
def u:nth(s, i) { unwrap(list_get(s.names, i)) }
def u:tick(b) { unwrap(list_get(["no", "yes"], b)) }

# ---------------------------------------------------------------------------
# ASCII: the first visual, and the one that always works
# ---------------------------------------------------------------------------

def u:show_table(s) {
  print(s.title)
  print("  elements:", s.names)
  print(disp(s.table))
}

# A law checklist, plus the rung of the ladder the structure reaches.
def u:show_laws(s) {
  c = u:classify(s.table)
  print("  closed      ", u:tick(c.closed))
  print("  associative ", u:tick(c.associative))
  print("  commutative ", u:tick(c.commutative))
  print("  identity    ", u:tick(c.identity))
  print("  inverses    ", u:tick(c.inverses))
  print("  =>", u:structure_name(s.table))
}

# A failed law must name a witness, never just say "no".
def u:show_assoc_counterexample(s) {
  x = u:assoc_counterexample(s.table)
  print("  associativity counterexample:")
  print("    a =", u:nth(s, x.a), " b =", u:nth(s, x.b), " c =", u:nth(s, x.c))
  print("    (a*b)*c:  a*b =", u:nth(s, x.ab), " -> ", u:nth(s, x.left))
  print("    a*(b*c):  b*c =", u:nth(s, x.bc), " -> ", u:nth(s, x.right))
  x
}

def u:show_comm_counterexample(s) {
  x = u:comm_counterexample(s.table)
  print("  commutativity counterexample:")
  print("    a =", u:nth(s, x.a), " b =", u:nth(s, x.b))
  print("    a*b =", u:nth(s, x.left), "  b*a =", u:nth(s, x.right))
  x
}

# ---------------------------------------------------------------------------
# SVG fragments
# ---------------------------------------------------------------------------

def u:svg_open(w, h) {
  u:cat5("<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 ",
    u:num(w), " ", u:num(h),
    "\" font-family=\"ui-monospace,Menlo,monospace\" font-size=\"12\">")
}

def u:svg_rect(x, y, w, h, fill) {
  u:cat5(u:cat5("<rect x=\"", u:num(x), "\" y=\"", u:num(y), "\" width=\""),
    u:num(w), "\" height=\"", u:num(h), u:cat3("\" fill=\"", fill, "\"/>"))
}

def u:svg_frame(x, y, w, h, stroke) {
  u:cat5(u:cat5("<rect x=\"", u:num(x), "\" y=\"", u:num(y), "\" width=\""),
    u:num(w), "\" height=\"", u:num(h),
    u:cat3("\" fill=\"none\" stroke-width=\"3\" stroke=\"", stroke, "\"/>"))
}

def u:svg_text(x, y, fill, s) {
  u:cat5(u:cat5("<text x=\"", u:num(x), "\" y=\"", u:num(y), "\" fill=\""),
    fill, "\" text-anchor=\"middle\" dominant-baseline=\"central\">", s,
    "</text>")
}

def u:svg_text_left(x, y, fill, s) {
  u:cat5(u:cat5("<text x=\"", u:num(x), "\" y=\"", u:num(y), "\" fill=\""),
    fill, "\" text-anchor=\"start\" dominant-baseline=\"central\">", s,
    "</text>")
}

# Approximate rendered width of a monospace string, in px.
# BYTE length, not character length -- sw-MLPL cannot count characters
# (docs/mlpl-blockers.md, B3).  Exact for the ASCII labels used here; a
# non-ASCII title would over-estimate, which errs toward not clipping.
def u:text_px(s, font_px) { round(size(tokenize_bytes(s)) * font_px * 0.62) }

def u:max2(a, b) { if lt(a, b) { b } else { a } }

# ---------------------------------------------------------------------------
# SVG: the labelled, colored, highlighted Cayley table
# ---------------------------------------------------------------------------
#
# One color per element, so structure is visible before a single name is read:
# a constant row is one stripe; an identity row reproduces the header's colors;
# a group's table is a Latin square -- every color exactly once per row and
# column.  That last one is the payoff, and it is visible at a glance.

def u:palette(i) {
  unwrap(list_get(
    ["#7aa2f7", "#f7768e", "#9ece6a", "#e0af68", "#bb9af7",
     "#7dcfff", "#ff9e64", "#73daca"], mod(i, 8)))
}

def u:cell_px() { 64 }
def u:pad_px() { 68 }
def u:top_px() { 34 }

def u:cell_svg(s, a, b) {
  n = u:order(s.table)
  v = take(take(s.table, 0, a), 0, b)
  x = u:pad_px() + b * u:cell_px()
  y = u:top_px() + u:pad_px() + a * u:cell_px()
  inside = (1 - lt(v, 0)) * lt(v, n)
  fill = if inside { u:palette(v) } else { "#3b3b4d" }
  label = if inside { u:nth(s, v) } else { u:cat("!", u:num(v)) }
  u:cat(u:svg_rect(x + 2, y + 2, u:cell_px() - 4, u:cell_px() - 4, fill),
    u:svg_text(x + u:cell_px() / 2, y + u:cell_px() / 2, "#12131c", label))
}

# Recursive fold over the n*n cells: sw-MLPL has no string reduction, so the
# accumulator is threaded by hand.  Recursion, not an explicit loop.
def u:cells_svg(s, i, acc) {
  n = u:order(s.table)
  if lt(i, n * n) {
    u:cells_svg(s, i + 1, u:cat(acc, u:cell_svg(s, floor(i / n), mod(i, n))))
  } else { acc }
}

def u:headers_svg(s, i, acc) {
  if lt(i, u:order(s.table)) {
    col = u:svg_text(u:pad_px() + i * u:cell_px() + u:cell_px() / 2,
      u:top_px() + u:pad_px() - 14, "#c0caf5", u:nth(s, i))
    row = u:svg_text(u:pad_px() / 2,
      u:top_px() + u:pad_px() + i * u:cell_px() + u:cell_px() / 2,
      "#c0caf5", u:nth(s, i))
    u:headers_svg(s, i + 1, u:cat3(acc, col, row))
  } else { acc }
}

# A white ring around the identity's row and column, when one exists.  This is
# the picture of "e * x = x and x * e = x": both bands reproduce the headings.
def u:identity_svg(s) {
  n = u:order(s.table)
  e = u:identity_of(s.table)
  if u:has_identity(s.table) {
    u:cat(
      u:svg_frame(u:pad_px(), u:top_px() + u:pad_px() + e * u:cell_px(),
        n * u:cell_px(), u:cell_px(), "#ffffff"),
      u:svg_frame(u:pad_px() + e * u:cell_px(), u:top_px() + u:pad_px(),
        u:cell_px(), n * u:cell_px(), "#ffffff"))
  } else { "" }
}

# Cell geometry, shared by the static and animated diagrams.
def u:cell_x(b) { u:pad_px() + b * u:cell_px() }
def u:cell_y(a) { u:top_px() + u:pad_px() + a * u:cell_px() }
# Wide enough for the grid AND the title, so a long title is never clipped.
def u:grid_w(s) {
  u:max2(u:pad_px() + u:order(s.table) * u:cell_px() + 16,
    u:text_px(s.title, 12) + 32)
}
def u:grid_h(s) { u:top_px() + u:pad_px() + u:order(s.table) * u:cell_px() + 16 }

# Headings, cells, and the identity cross -- everything inside the <svg> that
# both the static and the animated diagram share.
def u:table_body(s) {
  u:cat3(u:headers_svg(s, 0, ""), u:cells_svg(s, 0, ""), u:identity_svg(s))
}

def u:cayley_svg(s) {
  w = u:grid_w(s)
  h = u:grid_h(s)
  u:cat3(
    u:cat3(u:svg_open(w, h), u:svg_rect(0, 0, w, h, "#1a1b26"),
      u:svg_text(w / 2, 18, "#c0caf5", s.title)),
    u:table_body(s),
    "</svg>")
}

# Render and write in one call; returns the Result from write_text.
def u:write_cayley_svg(path, s) { write_text(path, u:cayley_svg(s)) }

# ---------------------------------------------------------------------------
# Animated SVG: watching associativity fail
# ---------------------------------------------------------------------------
#
# Animation is SMIL, which is text, so it costs nothing that static SVG did not
# already cost -- no encoder, no new builtin, no binary format.  It stays
# scalable, diffable, and renders anywhere an <img> does.
#
# The animation IS the lesson.  Two markers start on different cells and walk
# the two bracketings of the same three elements:
#
#   left  marker: (a, b) -> read a*b -> (a*b, c) -> read (a*b)*c
#   right marker: (b, c) -> read b*c -> (a, b*c) -> read a*(b*c)
#
# They land on different colors.  That is what non-associativity looks like,
# and no prose does it as well.

# One marker: a ring that dwells on a cell, slides, and dwells again.  `values`
# and `keyTimes` carry the whole path, so the animation is declarative and the
# document needs no script.
def u:marker_svg(x0, y0, x1, y1, color, delay) {
  u:cat5(
    u:cat5("<rect x=\"", u:num(x0), "\" y=\"", u:num(y0), "\" "),
    u:cat5("width=\"", u:num(u:cell_px()), "\" height=\"", u:num(u:cell_px()), "\" "),
    u:cat3("fill=\"none\" stroke=\"", color, "\" stroke-width=\"4\" rx=\"6\">"),
    u:cat(
      u:anim_svg("x", u:dwell(x0, x1), delay),
      u:anim_svg("y", u:dwell(y0, y1), delay)),
    "</rect>")
}

# Two stops, each held long enough to read: start, hold, slide, hold.
def u:dwell(v0, v1) {
  u:cat5(u:num(v0), ";", u:num(v0), ";", u:cat3(u:num(v1), ";", u:num(v1)))
}

# values and keyTimes must have equal length -- a mismatch makes the browser
# drop the animation silently, which is why tests/test_render.mlpl counts both.
def u:anim_svg(attr, values, delay) {
  u:cat5(
    u:cat3("<animate attributeName=\"", attr, "\" "),
    u:cat3("values=\"", values, "\" "),
    "keyTimes=\"0;0.35;0.5;1\" dur=\"5s\" ",
    u:cat3("begin=\"", u:num(delay), "s\" "),
    "repeatCount=\"indefinite\" calcMode=\"linear\"/>")
}

# A legend row: marker swatch, the expression, then the element it reaches in
# that element's own color.  Laid out from the right edge so nothing runs off.
def u:legend_svg(s, y, color, label, result) {
  w = u:grid_w(s)
  u:cat3(
    u:cat(u:svg_rect(16, y - 8, 14, 14, color),
      u:svg_text_left(38, y, "#c0caf5", label)),
    u:svg_text_left(112, y, "#565f89", "="),
    u:cat(u:svg_rect(w - 132, y - 8, 14, 14, u:palette(result)),
      u:svg_text_left(w - 110, y, "#c0caf5", u:nth(s, result))))
}

# The whole animated diagram.  Returns "" when the operation IS associative --
# there is no counterexample to walk, and drawing one would be a lie.
def u:assoc_walk_svg(s) {
  x = u:assoc_counterexample(s.table)
  if x.found { u:assoc_walk_found(s, x) } else { "" }
}

def u:assoc_walk_found(s, x) {
  w = u:grid_w(s)
  h = u:grid_h(s) + 76
  caption = u:cat5("(", u:nth(s, x.a), "*", u:nth(s, x.b),
    u:cat5(")*", u:nth(s, x.c), "  vs  ", u:nth(s, x.a), "*("))
  u:cat3(
    u:cat3(u:svg_open(w, h), u:svg_rect(0, 0, w, h, "#1a1b26"),
      u:svg_text(w / 2, 18, "#c0caf5", s.title)),
    u:cat3(u:table_body(s),
      # Left bracketing: (a*b) then (a*b)*c.
      u:marker_svg(u:cell_x(x.b), u:cell_y(x.a), u:cell_x(x.c), u:cell_y(x.ab),
        "#ffffff", 0),
      # Right bracketing: (b*c) then a*(b*c).  Offset so both are readable.
      u:marker_svg(u:cell_x(x.c), u:cell_y(x.b), u:cell_x(x.bc), u:cell_y(x.a),
        "#f7768e", 0.4)),
    u:cat3(
      u:legend_svg(s, u:grid_h(s) + 12, "#ffffff", "(a*b)*c", x.left),
      u:legend_svg(s, u:grid_h(s) + 40, "#f7768e", "a*(b*c)", x.right),
      "</svg>"))
}

def u:write_assoc_walk_svg(path, s) { write_text(path, u:assoc_walk_svg(s)) }

# ---------------------------------------------------------------------------
# The dominance digraph: the same operation, drawn as a graph
# ---------------------------------------------------------------------------
#
# A "winner" operation carries a relation inside it: a beats b exactly when
# a * b = a and a is not b.  Drawing that relation gives a third view of one
# object -- function, table, graph -- and for Rock-Paper-Scissors-Lizard-Spock
# the graph is the view that makes the rules memorable.
#
# Nothing new is computed here.  The graph reads the SAME table the laws are
# checked against, which is the point: three views, one source of truth.

def u:ring_r(s) { 36 + 28 * u:order(s.table) }
def u:ring_cx(s) { u:ring_r(s) + 60 }
def u:ring_cy(s) { u:ring_r(s) + 74 }
def u:node_r() { 32 }

# Node i sits at angle -pi/2 + 2*pi*i/n, so element 0 is at the top.
def u:node_x(s, i) {
  u:ring_cx(s) + u:ring_r(s) * cos(0 - pi() / 2 + 2 * pi() * i / u:order(s.table))
}
def u:node_y(s, i) {
  u:ring_cy(s) + u:ring_r(s) * sin(0 - pi() / 2 + 2 * pi() * i / u:order(s.table))
}

# a beats b when the operation returns a and the two differ.
def u:beats_cell(s, a, b) {
  eq(take(take(s.table, 0, a), 0, b), a) * (1 - eq(a, b))
}

# An arrow from a to b, stopped short of both node circles so the head is
# visible rather than buried under the target.
def u:edge_svg(s, a, b) {
  x0 = u:node_x(s, a)
  y0 = u:node_y(s, a)
  dx = u:node_x(s, b) - x0
  dy = u:node_y(s, b) - y0
  len = sqrt(dx * dx + dy * dy)
  ux = dx / len
  uy = dy / len
  gap = u:node_r() + 8
  u:cat5(
    u:cat5("<line x1=\"", u:num(round(x0 + ux * gap)), "\" y1=\"",
      u:num(round(y0 + uy * gap)), "\" "),
    u:cat5("x2=\"", u:num(round(x0 + dx - ux * gap)), "\" y2=\"",
      u:num(round(y0 + dy - uy * gap)), "\" "),
    "stroke=\"#565f89\" stroke-width=\"2\" ",
    "marker-end=\"url(#arrow)\"", "/>")
}

def u:edges_svg(s, i, acc) {
  n = u:order(s.table)
  if lt(i, n * n) {
    a = floor(i / n)
    b = mod(i, n)
    piece = if u:beats_cell(s, a, b) { u:edge_svg(s, a, b) } else { "" }
    u:edges_svg(s, i + 1, u:cat(acc, piece))
  } else { acc }
}

def u:nodes_svg(s, i, acc) {
  if lt(i, u:order(s.table)) {
    node = u:cat(
      u:cat3(
        u:cat5("<circle cx=\"", u:num(round(u:node_x(s, i))), "\" cy=\"",
          u:num(round(u:node_y(s, i))), "\" "),
        u:cat3("r=\"", u:num(u:node_r()), "\" fill=\""),
        u:cat3(u:palette(i), "\" stroke=\"#1a1b26\" stroke-width=\"3\"", "/>")),
      u:svg_text(round(u:node_x(s, i)), round(u:node_y(s, i)), "#12131c",
        u:nth(s, i)))
    u:nodes_svg(s, i + 1, u:cat(acc, node))
  } else { acc }
}

def u:arrow_defs() {
  u:cat3("<defs><marker id=\"arrow\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" ",
    "markerWidth=\"6\" markerHeight=\"6\" orient=\"auto-start-reverse\">",
    "<path d=\"M 0 0 L 10 5 L 0 10 z\" fill=\"#565f89\"/></marker></defs>")
}

def u:dominance_svg(s) {
  w = u:max2(2 * u:ring_cx(s), u:text_px(s.title, 12) + 32)
  h = u:ring_cy(s) + u:ring_r(s) + 60
  u:cat3(
    u:cat3(u:svg_open(w, h), u:svg_rect(0, 0, w, h, "#1a1b26"),
      u:svg_text(w / 2, 18, "#c0caf5", s.title)),
    u:cat3(u:arrow_defs(), u:edges_svg(s, 0, ""), u:nodes_svg(s, 0, "")),
    "</svg>")
}

def u:write_dominance_svg(path, s) { write_text(path, u:dominance_svg(s)) }

# ---------------------------------------------------------------------------
# JSON: the transport to viewer/ pages
# ---------------------------------------------------------------------------

# Everything a viewer page needs about one structure, as a JSON string.  The
# MLPL side stays authoritative: the page renders these verdicts, and
# tests/test_viewer_conformance.mlpl pins the fixture it is checked against.
def u:structure_record(s) {
  {
    title: s.title,
    elements: s.names,
    table: s.table,
    laws: u:classify(s.table),
    structure: u:structure_name(s.table),
    identity: u:identity_of(s.table),
    identity_mask: u:identity_mask(s.table),
    invertible_mask: u:invertible_mask(s.table),
    assoc_counterexample: u:assoc_counterexample(s.table),
    comm_counterexample: u:comm_counterexample(s.table)
  }
}

def u:structure_json(s) { unwrap(to_json(u:structure_record(s), {tagged: 1})) }

def u:write_structure_json(path, s) { write_text(path, u:structure_json(s)) }
# ---- end ../../lib/render.mlpl ----


# Ordered so each element beats the next two going around the circle.
def u:gap5(x, y) { mod(x - y + 5, 5) }
def u:beats5(x, y) { lt(u:gap5(x, y) - 1, 2) * (1 - eq(u:gap5(x, y), 0)) }
def u:fight5(x, y) { if u:beats5(x, y) { x } else { y } }

u:dominance_svg({
  title: "Rock-Paper-Scissors-Lizard-Spock: who beats whom",
  names: ["spock", "paper", "lizard", "scissors", "rock"],
  table: table(:u:fight5, u:elements(5), u:elements(5))
})
