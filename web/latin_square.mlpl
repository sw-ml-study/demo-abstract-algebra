# **************************************************************************
# * WHAT THIS SHOWS
# *
# * The difference between a MAGMA and a GROUP, as two labelled tables.
# * Every cell carries the name AND the colour of its result, so the pattern
# * is visible before you read a single word.
# **************************************************************************
;
def u:winner_of(x, y) { "Answer the winner of a matchup; a tie answers the shared choice."; if eq(mod(x - y + 3, 3), 1) { x } else { y } }  # Rock-Paper-Scissors
def u:add_mod_3(x, y) { "Answer the sum modulo 3, the operation of the cyclic group Z3."; mod(x + y, 3) }  # Z3, addition mod 3
def u:element_color(i) { "Answer the colour that stands for element i, shared by the graph and the table."; unwrap(list_get(["#7aa2f7", "#f7768e", "#9ece6a", "#e0af68", "#bb9af7"], mod(i, 5))) }
def u:label(x, y, fill, sz, str) { "Answer a text element centred on the given point."; str_concat(str_concat(str_concat("<text x=\"", to_string(x)), str_concat("\" y=\"", to_string(y))), str_concat(str_concat(str_concat("\" fill=\"", fill), str_concat("\" font-size=\"", to_string(sz))), str_concat(str_concat("\" text-anchor=\"middle\" dominant-baseline=\"central\" font-family=\"monospace\">", str), "</text>"))) }
def u:cell(a, b, v, nm) { "Answer one table cell: a coloured square carrying the name of its result."; str_concat(str_concat(str_concat(str_concat("<rect x=\"", to_string(70 + b * 62)), str_concat("\" y=\"", to_string(70 + a * 62))), str_concat(str_concat("\" width=\"58\" height=\"58\" rx=\"4\" fill=\"", u:element_color(v)), "\"/>")), u:label(99 + b * 62, 99 + a * 62, "#12131c", 11, unwrap(list_get(nm.names, v)))) }
def u:all_cells(t, i, nm, acc) { "Answer every cell of the table, folded together by recursion."; if lt(i, tally(t) * tally(t)) { u:all_cells(t, i + 1, nm, str_concat(acc, u:cell(floor(i / tally(t)), mod(i, tally(t)), take(take(t, 0, floor(i / tally(t))), 0, mod(i, tally(t))), nm))) } else { acc } }
def u:headings(k, i, nm, acc) { "Answer the row and column headings."; if lt(i, k) { u:headings(k, i + 1, nm, str_concat(acc, str_concat(u:label(99 + i * 62, 56, "#c0caf5", 11, unwrap(list_get(nm.names, i))), u:label(36, 99 + i * 62, "#c0caf5", 11, unwrap(list_get(nm.names, i)))))) } else { acc } }
def u:canvas_size(t) { "Answer the square canvas edge for a table of this order."; 86 + tally(t) * 62 }  # square, so one number does for both
def u:svg_header(t) { "Answer the opening svg tag and background. Width and height are required or it collapses inline."; str_concat(str_concat(str_concat("<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 ", to_string(u:canvas_size(t))), str_concat(" ", to_string(u:canvas_size(t)))), str_concat(str_concat(str_concat("\" width=\"", to_string(u:canvas_size(t))), str_concat("\" height=\"", to_string(u:canvas_size(t)))), "\"><rect width=\"100%\" height=\"100%\" fill=\"#1a1b26\"/>")) }  # width/height or it collapses inline
def u:cayley_grid(t, nm) { "Answer the labelled, colour-coded Cayley table as an SVG document."; str_concat(str_concat(u:svg_header(t), u:headings(tally(t), 0, nm, "")), str_concat(u:all_cells(t, 0, nm, ""), "</svg>")) }
rps = {names: ["rock", "paper", "scis"]}  # short names so cells stay legible
z3 = {names: ["0", "1", "2"]}
# **************************************************************************
# * TABLE 1 -- ROCK-PAPER-SCISSORS, a magma
# *
# * Rows and columns both run rock, paper, scissors. A cell is the winner of
# * row-vs-column, coloured by which element that is.
# *
# * Look along any row: blue appears twice in the first row, and the third
# * row has blue, green, green. Colours repeat and others go missing.
# **************************************************************************
u:cayley_grid(table(:u:winner_of, range(3), range(3)), rps)
# **************************************************************************
# * TABLE 2 -- Z3 UNDER ADDITION, a group
# *
# * Same layout: rows and columns are 0, 1, 2, and a cell is their sum
# * modulo 3.
# *
# * Now look along any row, or any column: each of the three colours appears
# * EXACTLY ONCE. No repeats, nothing missing.
# **************************************************************************
u:cayley_grid(table(:u:add_mod_3, range(3), range(3)), z3)
# **************************************************************************
# * WHAT TO NOTICE
# *
# * That second pattern -- every element once per row and once per column --
# * is called a LATIN SQUARE, and it is what being a GROUP looks like.
# *
# * Each row is a shuffle of the elements rather than a random assortment.
# * That is the same thing as saying nothing is ever lost: whatever a row
# * starts from, every possible answer is reachable exactly one way, so every
# * element has an inverse.
# *
# * THE POINT -- you can tell a group from a magma across the room, without
# * reading a single number. Table 1 has repeats; table 2 does not.
# **************************************************************************
