# **************************************************************************
# * WHAT THIS SHOWS
# *
# * THREE labelled tables, and the difference between what a pattern shows
# * and what it proves. Every cell carries the name AND the colour of its
# * result, so the pattern is visible before you read a single word.
# **************************************************************************
;
def u:winner_of(x, y) { "Answer the winner of a matchup; a tie answers the shared choice."; if eq(mod(x - y + 3, 3), 1) { x } else { y } }  # Rock-Paper-Scissors
def u:add_mod_3(x, y) { "Answer the sum modulo 3, the operation of the cyclic group Z3."; mod(x + y, 3) }  # Z3, addition mod 3
def u:sub_mod_3(x, y) { "Answer x minus y modulo 3: a Latin square that is not a group."; mod(x - y + 3, 3) }  # subtraction mod 3
# ==========================================================================
# RENDERING SUPPORT
#
# Nothing below this line is needed to define the algebra. It only turns
# the operation into a picture, and it is here only because the browser
# cannot load a shared library. Skip to the next block of narration.
# ==========================================================================
def u:element_color(i) { "SVG helper: the colour that stands for an element, shared by the graph and the table."; unwrap(list_get(["#7aa2f7", "#f7768e", "#9ece6a", "#e0af68", "#bb9af7"], mod(i, 5))) }
def u:label(x, y, fill, font_size, text) { "SVG helper: a text element centred on a point."; str_concat(str_concat(str_concat("<text x=\"", to_string(x)), str_concat("\" y=\"", to_string(y))), str_concat(str_concat(str_concat("\" fill=\"", fill), str_concat("\" font-size=\"", to_string(font_size))), str_concat(str_concat("\" text-anchor=\"middle\" dominant-baseline=\"central\" font-family=\"monospace\">", text), "</text>"))) }
def u:cell(row, column, result, names) { "SVG helper: one table cell, a coloured square carrying the name of its result."; str_concat(str_concat(str_concat(str_concat("<rect x=\"", to_string(70 + column * 62)), str_concat("\" y=\"", to_string(70 + row * 62))), str_concat(str_concat("\" width=\"58\" height=\"58\" rx=\"4\" fill=\"", u:element_color(result)), "\"/>")), u:label(99 + column * 62, 99 + row * 62, "#12131c", 11, unwrap(list_get(names, result)))) }
def u:all_cells(operation, cell_index, names, svg_so_far) { "SVG helper: every cell of the table, folded together by recursion."; if lt(cell_index, tally(operation) * tally(operation)) { u:all_cells(operation, cell_index + 1, names, str_concat(svg_so_far, u:cell(floor(cell_index / tally(operation)), mod(cell_index, tally(operation)), take(take(operation, 0, floor(cell_index / tally(operation))), 0, mod(cell_index, tally(operation))), names))) } else { svg_so_far } }
def u:headings(element_count, element, names, svg_so_far) { "SVG helper: the row and column headings."; if lt(element, element_count) { u:headings(element_count, element + 1, names, str_concat(svg_so_far, str_concat(u:label(99 + element * 62, 56, "#c0caf5", 11, unwrap(list_get(names, element))), u:label(36, 99 + element * 62, "#c0caf5", 11, unwrap(list_get(names, element)))))) } else { svg_so_far } }
def u:canvas_size(operation) { "SVG helper: the square canvas edge for a table of this order."; 86 + tally(operation) * 62 }  # square, so one number does for both
def u:svg_header(operation) { "SVG helper: the opening svg tag and background. Width and height are required or it collapses inline."; str_concat(str_concat(str_concat("<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 ", to_string(u:canvas_size(operation))), str_concat(" ", to_string(u:canvas_size(operation)))), str_concat(str_concat(str_concat("\" width=\"", to_string(u:canvas_size(operation))), str_concat("\" height=\"", to_string(u:canvas_size(operation)))), "\"><rect width=\"100%\" height=\"100%\" fill=\"#1a1b26\"/>")) }  # width/height or it collapses inline
def u:cayley_grid(operation, names) { "SVG helper: the labelled, colour-coded Cayley table as an SVG document."; str_concat(str_concat(u:svg_header(operation), u:headings(tally(operation), 0, names, "")), str_concat(u:all_cells(operation, 0, names, ""), "</svg>")) }
rps = ["rock", "paper", "scis"]  # short names so cells stay legible
z3 = ["0", "1", "2"]
digits = ["0", "1", "2"]
# **************************************************************************
# * TABLE 1 -- ROCK-PAPER-SCISSORS, a magma and nothing more
# *
# * Rows and columns both run rock, paper, scissors. A cell is the winner of
# * row-vs-column, coloured by which element that is.
# *
# * Look along any row: blue appears twice in the first row, and the third
# * row has blue, green, green. Colours repeat and others go missing, so this
# * is NOT a Latin square. Hold that comparison for the next two.
# **************************************************************************
u:cayley_grid(table(:u:winner_of, range(3), range(3)), rps)
# **************************************************************************
# * TABLE 2 -- SUBTRACTION MODULO 3
# *
# * Rows and columns are 0, 1, 2; a cell is row minus column, modulo 3.
# *
# * Look along any row, or any column: each of the three colours appears
# * EXACTLY ONCE. No repeats, nothing missing. That pattern has a name -- a
# * LATIN SQUARE -- and it is the pattern people point at when they say a
# * table "looks like a group".
# **************************************************************************
u:cayley_grid(table(:u:sub_mod_3, range(3), range(3)), digits)
# **************************************************************************
# * TABLE 3 -- ADDITION MODULO 3
# *
# * Same layout, and also a Latin square.
# **************************************************************************
u:cayley_grid(table(:u:add_mod_3, range(3), range(3)), z3)
# **************************************************************************
# * WHAT TO NOTICE
# *
# * Tables 2 and 3 wear the SAME pattern. Table 3 is a group. Table 2 is not:
# * subtraction modulo 3 has no identity element and is not associative --
# * (0 - 0) - 1 is 2, while 0 - (0 - 1) is 1.
# *
# * So the Latin pattern does not prove what it appears to. What it does prove
# * is that a * x = b and x * a = b always have exactly one solution, which
# * makes the operation a QUASIGROUP. Table 1 is not even that: rock appears
# * twice in one row, so "what beats paper to give rock" has two answers.
# *
# * The ladder that pattern belongs to is a different one:
# *
# *     magma  --unique division-->  quasigroup
# *            --identity-------->   loop
# *            --associativity--->   group
# *
# * THE POINT -- a picture SUGGESTS, a law test ESTABLISHES. Every group is a
# * Latin square, so the shape is worth recognising; but two tables can be
# * indistinguishable at a glance and sit on different rungs. That is not a
# * failure of the visual method, it is the reason the checks are executable.
# **************************************************************************
