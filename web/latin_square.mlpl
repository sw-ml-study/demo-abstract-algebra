# **************************************************************************
# * WHAT THIS SHOWS
# *
# * The difference between a MAGMA and a GROUP, as two labelled tables.
# * Every cell carries the name AND the colour of its result, so the pattern
# * is visible before you read a single word.
# **************************************************************************
;
def u:fight(x, y) { if eq(mod(x - y + 3, 3), 1) { x } else { y } }  # Rock-Paper-Scissors
def u:add3(x, y) { mod(x + y, 3) }  # Z3, addition mod 3
def u:cat(a, b) { decode_bytes(concat(tokenize_bytes(a), tokenize_bytes(b))) }  # plumbing: no labelled grid renderer
def u:nm(v) { unwrap(to_json(round(v))) }
def u:col(i) { unwrap(list_get(["#7aa2f7", "#f7768e", "#9ece6a", "#e0af68", "#bb9af7"], mod(i, 5))) }
def u:txt(x, y, fill, sz, str) { u:cat(u:cat(u:cat("<text x=\"", u:nm(x)), u:cat("\" y=\"", u:nm(y))), u:cat(u:cat(u:cat("\" fill=\"", fill), u:cat("\" font-size=\"", u:nm(sz))), u:cat(u:cat("\" text-anchor=\"middle\" dominant-baseline=\"central\" font-family=\"monospace\">", str), "</text>"))) }
def u:box(a, b, v, nm) { u:cat(u:cat(u:cat(u:cat("<rect x=\"", u:nm(70 + b * 62)), u:cat("\" y=\"", u:nm(70 + a * 62))), u:cat(u:cat("\" width=\"58\" height=\"58\" rx=\"4\" fill=\"", u:col(v)), "\"/>")), u:txt(99 + b * 62, 99 + a * 62, "#12131c", 11, unwrap(list_get(nm.names, v)))) }
def u:cells(t, i, nm, acc) { if lt(i, tally(t) * tally(t)) { u:cells(t, i + 1, nm, u:cat(acc, u:box(floor(i / tally(t)), mod(i, tally(t)), take(take(t, 0, floor(i / tally(t))), 0, mod(i, tally(t))), nm))) } else { acc } }
def u:heads(k, i, nm, acc) { if lt(i, k) { u:heads(k, i + 1, nm, u:cat(acc, u:cat(u:txt(99 + i * 62, 56, "#c0caf5", 11, unwrap(list_get(nm.names, i))), u:txt(36, 99 + i * 62, "#c0caf5", 11, unwrap(list_get(nm.names, i)))))) } else { acc } }
def u:sz(t) { 86 + tally(t) * 62 }  # square, so one number does for both
def u:open(t) { u:cat(u:cat(u:cat("<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 ", u:nm(u:sz(t))), u:cat(" ", u:nm(u:sz(t)))), u:cat(u:cat(u:cat("\" width=\"", u:nm(u:sz(t))), u:cat("\" height=\"", u:nm(u:sz(t)))), "\"><rect width=\"100%\" height=\"100%\" fill=\"#1a1b26\"/>")) }  # width/height or it collapses inline
def u:grid(t, nm) { u:cat(u:cat(u:open(t), u:heads(tally(t), 0, nm, "")), u:cat(u:cells(t, 0, nm, ""), "</svg>")) }
rps = {names: ["rock", "paper", "scis"]}  # short names so cells stay legible
z3 = {names: ["0", "1", "2"]}
# **************************************************************************
# * TABLE 1 -- ROCK-PAPER-SCISSORS, a magma
# *
# * Rows and columns both run rock, paper, scissors. A cell is the winner of
# * row-vs-column, coloured by which element that is.
# *
# * Look along any row: blue appears twice in the first row, and the third
# * row has blue, green, green. Colours repeat and others go missing.
# **************************************************************************
u:grid(table(:u:fight, range(3), range(3)), rps)
# **************************************************************************
# * TABLE 2 -- Z3 UNDER ADDITION, a group
# *
# * Same layout: rows and columns are 0, 1, 2, and a cell is their sum
# * modulo 3.
# *
# * Now look along any row, or any column: each of the three colours appears
# * EXACTLY ONCE. No repeats, nothing missing.
# **************************************************************************
u:grid(table(:u:add3, range(3), range(3)), z3)
# **************************************************************************
# * WHAT TO NOTICE
# *
# * That second pattern -- every element once per row and once per column --
# * is called a LATIN SQUARE, and it is what being a GROUP looks like.
# *
# * Each row is a shuffle of the elements rather than a random assortment.
# * That is the same thing as saying nothing is ever lost: whatever a row
# * starts from, every possible answer is reachable exactly one way, so every
# * element has an inverse.
# *
# * THE POINT -- you can tell a group from a magma across the room, without
# * reading a single number. Table 1 has repeats; table 2 does not.
# **************************************************************************
