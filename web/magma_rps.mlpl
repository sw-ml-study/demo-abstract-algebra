# **************************************************************************
# * WHAT THIS SHOWS
# *
# * The game you already know, drawn as a cycle of arrows, and then the SAME
# * thing as an algebra table.
# *
# * Rock-Paper-Scissors is a MAGMA: a set with one closed binary operation,
# * and nothing else. No associativity, no identity, no inverses.
# **************************************************************************
;
def u:beats(x, y) { eq(mod(x - y + 3, 3), 1) }  # beats the next one around
def u:fight(x, y) { if u:beats(x, y) { x } else { y } }  # the winner
def u:cat(a, b) { decode_bytes(concat(tokenize_bytes(a), tokenize_bytes(b))) }  # plumbing: no graph type
def u:nm(v) { unwrap(to_json(round(v))) }
def u:col(i) { unwrap(list_get(["#7aa2f7", "#f7768e", "#9ece6a", "#e0af68", "#bb9af7"], mod(i, 5))) }  # same palette as the tables
def u:px(i, k) { 190 + 130 * cos(2 * pi() * i / k - pi() / 2) }
def u:py(i, k) { 190 + 130 * sin(2 * pi() * i / k - pi() / 2) }
def u:ex(a, b, k, f) { u:px(a, k) + (u:px(b, k) - u:px(a, k)) * f }
def u:ey(a, b, k, f) { u:py(a, k) + (u:py(b, k) - u:py(a, k)) * f }
def u:seg(a, b, k) { u:cat(u:cat(u:cat("<line x1=\"", u:nm(u:ex(a, b, k, 0.24))), u:cat("\" y1=\"", u:nm(u:ey(a, b, k, 0.24)))), u:cat(u:cat(u:cat("\" x2=\"", u:nm(u:ex(a, b, k, 0.76))), u:cat("\" y2=\"", u:nm(u:ey(a, b, k, 0.76)))), "\" stroke=\"#7aa2f7\" stroke-width=\"3\" marker-end=\"url(#a)\"/>")) }
def u:dot(i, k, nm) { u:cat(u:cat(u:cat("<circle cx=\"", u:nm(u:px(i, k))), u:cat("\" cy=\"", u:nm(u:py(i, k)))), u:cat(u:cat(u:cat("\" r=\"37\" fill=\"", u:col(i)), "\"/>"), u:cat(u:cat(u:cat("<text x=\"", u:nm(u:px(i, k))), u:cat("\" y=\"", u:nm(u:py(i, k)))), u:cat(u:cat("\" fill=\"#12131c\" text-anchor=\"middle\" dominant-baseline=\"central\" font-size=\"12\" font-family=\"monospace\">", unwrap(list_get(nm.names, i))), "</text>")))) }
def u:arrows(i, k, acc) { if lt(i, k * k) { u:arrows(i + 1, k, if u:beats(floor(i / k), mod(i, k)) { u:cat(acc, u:seg(floor(i / k), mod(i, k), k)) } else { acc }) } else { acc } }
def u:nodes(i, k, nm, acc) { if lt(i, k) { u:nodes(i + 1, k, nm, u:cat(acc, u:dot(i, k, nm))) } else { acc } }
def u:cycle(k, nm) { u:cat(u:cat("<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 380 380\" width=\"380\" height=\"380\"><rect width=\"100%\" height=\"100%\" fill=\"#1a1b26\"/><defs><marker id=\"a\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"5\" markerHeight=\"5\" orient=\"auto-start-reverse\"><path d=\"M 0 0 L 10 5 L 0 10 z\" fill=\"#7aa2f7\"/></marker></defs>", u:arrows(0, k, "")), u:cat(u:nodes(0, k, nm, ""), "</svg>")) }
# **************************************************************************
# * PICTURE 1 -- THE BEATS CYCLE
# *
# * Three circles, one per choice. An arrow a -> b means "a beats b": rock
# * smashes scissors, scissors cuts paper, paper covers rock.
# *
# * The arrows form ONE closed loop, with no start and no end. That is why the
# * game is fair -- no choice sits at the top -- and it is the first hint that
# * the operation cannot be associative, because a cycle gives you no
# * consistent way to bracket three steps.
# **************************************************************************
u:cycle(3, {names: ["rock", "paper", "scissors"]})
t = table(:u:fight, range(3), range(3))  # every matchup at once
# **************************************************************************
# * PICTURE 2 -- THE SAME OPERATION AS AN ARRAY
# *
# * A 3x3 grid, one square per matchup. Rows and columns both run
# * rock, paper, scissors, in that order.
# *
# * A square's color is WHO WON, on the viridis ramp:
# *   dark purple = rock (0)   teal = paper (1)   yellow = scissors (2)
# *
# * Both pictures hold the same information. The arrows above are just the
# * off-diagonal squares where the row beats the column.
# **************************************************************************
svg(t, "heatmap")
# **************************************************************************
# * WHAT TO NOTICE
# *
# * CLOSURE. Every square holds one of the three choices. The operation never
# * produces a fourth thing, so the set is closed under it -- and closure is
# * the only law a magma requires. Picture 2 is what closure looks like.
# *
# * SYMMETRY. The grid is a mirror image across its diagonal, so the winner
# * does not depend on who moved first. The operation is commutative.
# *
# * NO IDENTITY. No row and no column reproduces the header order
# * rock, paper, scissors. So no choice leaves every opponent unchanged,
# * and there is no identity element.
# *
# * THE POINT -- closure alone buys you a magma, and a magma is the bottom
# * rung of the ladder. Associativity, an identity, inverses: each is a
# * further law this operation does not obey. The cycle you already knew was
# * an algebraic structure all along.
# **************************************************************************
