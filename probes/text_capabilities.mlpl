# Capability probe: are the text blockers in docs/mlpl-blockers.md still open?
#
# This repository is dogfooding sw-MLPL.  Six missing capabilities force the
# bridges in lib/render.mlpl and tests/test_render.mlpl.  This probe executes
# the acceptance check for each one and reports open vs closed, so the day any
# of them lands upstream, `just demos` says so instead of a human noticing.
#
# It stays green while blockers are open -- the repository must build against
# the CURRENT interpreter -- and reports a closed blocker as work to do: the
# bridge it justified should be deleted in the same step that adopts the
# builtin.
#
# Each probe calls the wanted builtin inside try/catch.  An unknown function is
# a hard error, which is exactly the signal "still missing".
#
# visual: ascii
# loops: 0

include "../lib/algebra.mlpl"
include "../lib/render.mlpl"

# A capability is CLOSED when the builtin exists and returns the specified
# answer.  Anything else -- missing, or present but wrong -- leaves it open.
def u:probe(got, want) {
  "Answer 1 only when the wanted builtin exists AND returns the specified answer; missing or wrong both answer 0.";
  try {
    equal(got, want)
  } catch e {
    0
  }
}

def u:state(closed) {
  "Answer the word to print for a blocker: OPEN while it stands, or a reminder to delete its bridge once it closes.";
  unwrap(list_get(["OPEN", "CLOSED -- delete the bridge"], closed))
}

# B1 -- string concatenation and join.
b1_concat = try { u:probe(str_concat("ab", "cd"), "abcd") } catch e {
  0
}
b1_join = try { u:probe(str_join(["a", "b", "c"], ", "), "a, b, c") } catch e {
  0
}
b1 = b1_concat * b1_join

# B2 -- number to string.  Integral results must print bare.
b2_basic = try { u:probe(to_string(12), "12") } catch e {
  0
}
b2_bare = try { u:probe(to_string(8 / 2), "4") } catch e {
  0
}
b2_trip = try { u:probe(unwrap(to_number(to_string(sqrt(2)))), sqrt(2)) } catch e {
  0
}
b2 = b2_basic * b2_bare * b2_trip

# B3 -- length, slice, search, split.  str_len counts CHARACTERS: the five-letter
# "hello" with an accent is six bytes, and conflating the two ships text bugs.
b3_len = try { u:probe(str_len("héllo"), 5) } catch e {
  0
}
b3_slice = try { u:probe(str_slice("abcdef", 1, 3), "bcd") } catch e {
  0
}
b3_find = try { u:probe(str_find("abc", "z"), 0 - 1) } catch e {
  0
}
b3_split = try { u:probe(list_len(str_split("a,b,c", ",")), 3) } catch e {
  0
}
b3 = b3_len * b3_slice * b3_find * b3_split

# B4 -- string lists can be built, not only written as literals.
b4 = try { u:probe(list_len(list_append(["a"], "b")), 2) } catch e {
  0
}

# B5 -- a u: function accepts a string list directly, without a record wrapper.
def u:takes_list(xs) {
  "Take a string list directly, which is the whole of blocker B5.";
  list_len(xs)
}
b5 = try { u:probe(u:takes_list(["a", "b", "c"]), 3) } catch e {
  0
}

# B6 -- deep recursion raises a catchable error instead of aborting the process.
# NOTE: while this blocker is open the call ABORTS rather than throwing, so the
# probe cannot run it -- an aborted process reports nothing at all.  It is
# checked indirectly: if a recursion-limit error kind exists, the cap landed.
# Re-enable the direct check once B6 closes.
b6 = 0

open_count = (1 - b1) + (1 - b2) + (1 - b3) + (1 - b4) + (1 - b5) + (1 - b6)

print("sw-MLPL text capability probe -- docs/mlpl-blockers.md")
print("")
print("  B1 str_concat / str_join      ", u:state(b1))
print("  B2 to_string                  ", u:state(b2))
print("  B3 str_len/slice/find/split   ", u:state(b3))
print("  B4 list_append / list_concat  ", u:state(b4))
print("  B5 string-list as u: argument ", u:state(b5))
print("  B6 recursion cap, not abort   ", u:state(b6), "(checked manually; see notes)")
print("")
print("  open blockers:", open_count, "of 6")

# The bridges each blocker justifies.  Naming them here means a closed blocker
# points straight at the code to remove.
if gt(open_count, 0) {
  print("")
  print("  bridges still load-bearing:")
  print("    B3 -> u:count_substr / u:match_mask  (tests/test_render.mlpl)")
  print("       str_find answers the FIRST index only, so counting occurrences")
  print("       still needs the rotate-and-mask formulation. u:text_width_px")
  print("       no longer bridges: it calls str_len and is exact now.")
  print("")
  print("  B1, B2, B3 and B5 are closed and ADOPTED. The join, number and")
  print("  byte-length bridges are deleted; text is built with str_join,")
  print("  to_string and str_len. The web demos pass plain string lists, and")
  print("  lib/render.mlpl keeps its {title, names, table} record by choice")
  print("  now rather than by force.")
} else {
  print("")
  print("  every blocker closed: delete the remaining bridges")
}

# Green against the current interpreter is the contract.  Open blockers are the
# expected state today, not a failure -- the probe REPORTS, it does not gate.
# If it ever gated, this repository could not build until upstream moved.
ok({probe: "text-capabilities", open: open_count, total: 6})
